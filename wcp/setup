#!/bin/bash
# setup — installs wcp to the right place depending on the detected OS.
#
# Installs the bash `wcp` script to /usr/local/bin/wcp, or ~/.local/bin/wcp
# when that is not writable, and makes it executable.
#
# USAGE:
#   bash setup

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Logging

print_info() {
  printf '%s\n' "$*"
}

print_warn() {
  printf '%s\n' "$*" >&2
}

print_error() {
  printf '%s\n' "$*" >&2
}



# Report every missing runtime tool at once, before installing.
check_tools() {
    missing=""
    command -v curl >/dev/null 2>&1 || missing="$missing curl"
    command -v openssl >/dev/null 2>&1 || missing="$missing openssl"
    [ -z "$missing" ] && return 0
    print_info "wcp needs:$missing"
    if [ "$(uname -s)" = "Darwin" ]; then
        print_info "  brew install$missing"
    elif command -v apt >/dev/null 2>&1; then
        print_info "  sudo apt install$missing"
    elif command -v dnf >/dev/null 2>&1; then
        print_info "  sudo dnf install$missing"
    elif command -v pacman >/dev/null 2>&1; then
        print_info "  sudo pacman -S$missing"
    else
        print_info "  install them with your package manager"
    fi
    print_info ""
    printf "Install wcp anyway? [y/N] "
    read -r reply 2>/dev/null < /dev/tty || reply=""
    case "$reply" in
        [Yy]*) return 0 ;;
        *) echo "Stopped. Install the tools above, then rerun this script."
           exit 1 ;;
    esac
}

readonly WCP_BEGIN="# >>> wcp >>>"
readonly WCP_END="# <<< wcp <<<"

# The profile file the user's login shell actually reads.
profile_file() {
    case "$(basename "${SHELL:-}")" in
        zsh)  printf '%s\n' "$HOME/.zshrc" ;;
        bash)
            if [ -f "$HOME/.bashrc" ]; then
                printf '%s\n' "$HOME/.bashrc"
            else
                printf '%s\n' "$HOME/.bash_profile"
            fi
            ;;
        *)    printf '%s\n' "$HOME/.profile" ;;
    esac
}

add_to_path() {
    local dir="$1"
    local profile reply
    profile="$(profile_file)"

    if [ -f "$profile" ] && grep -qF "$WCP_BEGIN" "$profile"; then
        print_info "$profile already has a wcp block — leaving it alone."
        return 0
    fi

    print_info ""
    print_info "NOTE: $dir is not in your PATH."

    # Never prompt when nothing can answer.
    if [ ! -t 0 ]; then
        print_info "Not running interactively, so $profile was not modified."
        print_info "Add this to your shell profile:"
        print_info "  export PATH=\"\$PATH:$dir\""
        return 0
    fi

    read -rp "Add it to $profile automatically? [y/N] " reply || reply=""
    case "$reply" in
        [Yy]*) ;;
        *)
            print_info "Skipped. Add this yourself when you want it:"
            print_info "  export PATH=\"\$PATH:$dir\""
            return 0
            ;;
    esac

    {
        printf '\n%s\n' "$WCP_BEGIN"
        printf '%s\n' "# Added by the wcp setup script. To remove, delete this line"
        printf '%s\n' "# through the matching '<<< wcp <<<' line below."
        printf 'export PATH="$PATH:%s"\n' "$dir"
        printf '%s\n' "$WCP_END"
    } >> "$profile"

    print_info "Added to $profile, wrapped in $WCP_BEGIN / $WCP_END markers."
    print_info "Run 'source $profile' or open a new terminal to pick it up."
}

detect_os() {
    case "$(uname -s)" in
        Linux*)
            if grep -qi microsoft /proc/version 2>/dev/null; then
                printf 'wsl\n'
            else
                printf 'linux\n'
            fi
            ;;
        Darwin*) printf 'macos\n' ;;
        CYGWIN*|MINGW*|MSYS*) printf 'windows\n' ;;
        *) printf 'unknown\n' ;;
    esac
}


install_unix() {
    local target=""
    if [ -w /usr/local/bin ] || [ "$(id -u)" = "0" ]; then
        target="/usr/local/bin/wcp"
    else
        mkdir -p "$HOME/.local/bin"
        target="$HOME/.local/bin/wcp"
    fi

    cp "$SCRIPT_DIR/wcp" "$target"
    chmod +x "$target"
    print_info "Installed: $target"

    # Install tests.md alongside wcp.
    if [ -r "$SCRIPT_DIR/tests.md" ]; then
        cp "$SCRIPT_DIR/tests.md" "$(dirname "$target")/tests.md"
        print_info "Installed: $(dirname "$target")/tests.md"
    fi

    case ":$PATH:" in
        *":$(dirname "$target"):"*) ;;
        *) add_to_path "$(dirname "$target")" ;;
    esac
}


# Run

main() {
  check_tools

  OS="$(detect_os)"
  print_info "Detected: $OS"
  print_info ""

  case "$OS" in
      linux|macos|wsl)
          install_unix
          ;;
      windows)
          print_error "This installer only handles Linux, macOS and WSL."
          print_error "On Windows run setup.ps1 instead:"
          print_error "  powershell -ExecutionPolicy Bypass -File setup.ps1"
          exit 1
          ;;
      *)
          print_error "Unrecognized OS - copy 'wcp' into your PATH and chmod +x it."
          exit 1
          ;;
  esac

  print_info ""
  print_info "Done. Test with:"
  print_info "  wcp hello world"
}

main "$@"
