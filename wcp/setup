#!/usr/bin/env bash
# setup — installs wcp to the right place depending on the detected OS.
#
# On Linux/macOS (including WSL): installs the bash `wcp` script to
# /usr/local/bin/wcp (or ~/.local/bin/wcp if that's not writable/doesn't
# exist), and makes it executable.
#
# On native Windows (running this via Git Bash, MSYS2, or similar): installs
# both wcp.ps1 and a wcp.cmd launcher (so plain `wcp` works from cmd.exe,
# PowerShell, or a Git Bash prompt) into %USERPROFILE%\bin, and adds that
# folder to the user's PATH if it isn't already there.
#
# USAGE:
#   bash setup
#
# (If you're on native Windows with no bash available at all, see the
# "Manual Windows install" section in README.md instead — this script needs
# some kind of shell to run, which Git Bash/WSL/MSYS2 all provide.)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

detect_os() {
    case "$(uname -s)" in
        Linux*)
            if grep -qi microsoft /proc/version 2>/dev/null; then
                echo "wsl"
            else
                echo "linux"
            fi
            ;;
        Darwin*) echo "macos" ;;
        CYGWIN*|MINGW*|MSYS*) echo "windows" ;;
        *) echo "unknown" ;;
    esac
}

OS="$(detect_os)"
echo "Detected: $OS"
echo ""

# Markers so an uninstaller can delete exactly this block.
WCP_BEGIN="# >>> wcp >>>"
WCP_END="# <<< wcp <<<"

# The profile file the user's login shell actually reads.
profile_file() {
    case "$(basename "${SHELL:-}")" in
        zsh)  echo "$HOME/.zshrc" ;;
        bash)
            if [ -f "$HOME/.bashrc" ]; then
                echo "$HOME/.bashrc"
            else
                echo "$HOME/.bash_profile"
            fi
            ;;
        *)    echo "$HOME/.profile" ;;
    esac
}

add_to_path() {
    local dir="$1"
    local profile reply
    profile="$(profile_file)"

    if [ -f "$profile" ] && grep -qF "$WCP_BEGIN" "$profile"; then
        echo "$profile already has a wcp block — leaving it alone."
        return 0
    fi

    echo ""
    echo "NOTE: $dir is not in your PATH."

    # Never prompt when nothing can answer.
    if [ ! -t 0 ]; then
        echo "Not running interactively, so $profile was not modified."
        echo "Add this to your shell profile:"
        echo "  export PATH=\"\$PATH:$dir\""
        return 0
    fi

    read -rp "Add it to $profile automatically? [y/N] " reply || reply=""
    case "$reply" in
        [Yy]*) ;;
        *)
            echo "Skipped. Add this yourself when you want it:"
            echo "  export PATH=\"\$PATH:$dir\""
            return 0
            ;;
    esac

    {
        echo ""
        echo "$WCP_BEGIN"
        echo "# Added by the wcp setup script. To remove, delete this line"
        echo "# through the matching '<<< wcp <<<' line below."
        echo "export PATH=\"\$PATH:$dir\""
        echo "$WCP_END"
    } >> "$profile"

    echo "Added to $profile, wrapped in $WCP_BEGIN / $WCP_END markers."
    echo "Run 'source $profile' or open a new terminal to pick it up."
}

install_unix() {
    local target=""
    if [ -w /usr/local/bin ] || [ "$(id -u)" = "0" ]; then
        target="/usr/local/bin/wcp"
    else
        mkdir -p "$HOME/.local/bin"
        target="$HOME/.local/bin/wcp"
    fi

    cp "$SCRIPT_DIR/wcp" "$target"
    chmod +x "$target"
    echo "Installed: $target"

    case ":$PATH:" in
        *":$(dirname "$target"):"*) ;;
        *) add_to_path "$(dirname "$target")" ;;
    esac
}

install_windows() {
    # Convert a Unix-style path to a native Windows path.
    local win_home
    win_home="$(cd "$HOME" && pwd -W 2>/dev/null || echo "$HOME")"
    local bin_dir="$HOME/bin"
    mkdir -p "$bin_dir"

    cp "$SCRIPT_DIR/wcp.ps1" "$bin_dir/wcp.ps1"

    cat > "$bin_dir/wcp.cmd" << 'EOF'
@echo off
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0wcp.ps1" %*
EOF

    echo "Installed: $bin_dir/wcp.ps1"
    echo "Installed: $bin_dir/wcp.cmd"
    echo ""

    # Add to the Windows user PATH via PowerShell, if powershell.exe is reachable.
    if command -v powershell.exe &>/dev/null; then
        local win_bin_dir
        win_bin_dir="$(cd "$bin_dir" && pwd -W 2>/dev/null || echo "$bin_dir")"
        powershell.exe -NoProfile -Command "
            \$dir = '$win_bin_dir';
            \$current = [Environment]::GetEnvironmentVariable('Path', 'User');
            if (\$current -notlike \"*\$dir*\") {
                \$joined = \"\$current;\$dir\";
                [Environment]::SetEnvironmentVariable('Path', \$joined, 'User');
                Write-Output 'Added to User PATH - restart your terminal.';
            } else {
                Write-Output 'Already in PATH.';
            }
        "
    else
        echo "NOTE: couldn't find powershell.exe to update PATH automatically."
        echo "Add this folder to your Windows PATH manually: $bin_dir"
    fi
}

case "$OS" in
    linux|macos|wsl)
        install_unix
        ;;
    windows)
        install_windows
        ;;
    *)
        echo "Unrecognized OS — install manually:"
        echo "  Unix-like: copy 'wcp' to somewhere in your PATH, chmod +x it."
        echo "  Windows:   copy 'wcp.ps1' somewhere in your PATH (see README.md)."
        exit 1
        ;;
esac

echo ""
echo "Done. Test with:"
echo "  wcp hello world"
