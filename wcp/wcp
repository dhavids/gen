SET_KEY=""
DO_SET_KEY=0
DO_GET_KEY=0
DO_CLEAR_KEY=0
ARGS=()

# Read flags into globals, leaving positional args in ARGS.
parse_args() {
  # Expand bundled boolean flags, so -abc becomes -a -b -c.
  SHORT_FLAGS="cenpvhlfasz"
  VALUE_FLAGS="btko"
  SAW_DOUBLE_DASH=0
  raw_args=("$@")
  set --
  for arg in "${raw_args[@]}"; do
    if [[ "$arg" == "--" ]]; then
      SAW_DOUBLE_DASH=1
      set -- "$@" "--"
      continue
    fi
    if [[ $SAW_DOUBLE_DASH -eq 1 ]]; then
      set -- "$@" "$arg"
      continue
    fi
    if [[ "$arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
      bundled="${arg#-}"
      bad=""
      for (( i=0; i<${#bundled}; i++ )); do
        ch="${bundled:$i:1}"
        if [[ "$VALUE_FLAGS" == *"$ch"* ]]; then
          bad="$ch"
          break
        fi
        if [[ "$SHORT_FLAGS" != *"$ch"* ]]; then
          bad="$ch"
          break
        fi
      done
      if [[ -n "$bad" ]]; then
        print_error "-b, -t, -k and -o take a value and cannot be bundled (got '$arg')"
        exit 1
      fi
      for (( i=0; i<${#bundled}; i++ )); do
        set -- "$@" "-${bundled:$i:1}"
      done
    else
      set -- "$@" "$arg"
    fi
  done

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--backend)
        case "$2" in
          c|catbox)    BACKEND="catbox" ;;
          l|litterbox) BACKEND="litterbox" ;;
          *)           BACKEND="$2" ;;
        esac
        shift 2
        ;;
      --backend=*)
        val="${1#*=}"
        case "$val" in
          c|catbox)    BACKEND="catbox" ;;
          l|litterbox) BACKEND="litterbox" ;;
          *)           BACKEND="$val" ;;
        esac
        shift
        ;;
      --host)
        HOST="$2"
        shift 2
        ;;
      --host=*)
        HOST="${1#*=}"
        shift
        ;;
      -t|--time)
        LBHOURS="$2"
        shift 2
        ;;
      -t=*|--time=*)
        LBHOURS="${1#*=}"
        shift
        ;;
      -c|--copy)
        COPY=1
        shift
        ;;
      -n|--no-copy)
        NO_COPY=1
        shift
        ;;
      -o|--output)
        OUT_FILE="$2"
        shift 2
        ;;
      -k|--key-len)
        KEY_LEN="$2"
        shift 2
        ;;
      --key-len=*)
        KEY_LEN="${1#*=}"
        shift
        ;;
      -v|--paste)
        PASTE=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -e|--encrypt)
        EXPLICIT_ENCRYPT=1
        shift
        ;;
      -p|--plain)
        PLAIN=1
        shift
        ;;
      -l|--link)
        LINK=1
        shift
        ;;
      -f|--force)
        FORCE=1
        shift
        ;;
      -a|--accumulate)
        ACCUM=1
        shift
        ;;
      -s|--send)
        SEND=1
        shift
        ;;
      --clear)
        CLEAR=1
        shift
        ;;
      --full)
        FULL=1
        shift
        ;;
      --run-tests)
        DO_RUN_TESTS=1
        shift
        if [[ $# -gt 0 && "$1" != -* ]]; then
          TEST_SHEET="$1"
          shift
        fi
        ;;
      -z|--no-stored-key)
        NOKEY=1
        shift
        ;;
      --set-key)
        DO_SET_KEY=1
        shift
        # Optional value: only consume a token that is not itself a flag.
        if [[ $# -gt 0 && "$1" != -* ]]; then
          SET_KEY="$1"
          shift
        fi
        ;;
      --set-key=*)
        DO_SET_KEY=1
        SET_KEY="${1#*=}"
        shift
        ;;
      --get-key)
        DO_GET_KEY=1
        shift
        ;;
      --clear-key)
        DO_CLEAR_KEY=1
        shift
        ;;
      --)
        shift
        ARGS+=("$@")
        break
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
  return 0
}



# Handle --set-key, --get-key and --clear-key, then exit.
run_key_action() {
  # Key-store actions stand alone: they never combine with an upload.
  KEY_ACTIONS=$(( DO_SET_KEY + DO_GET_KEY + DO_CLEAR_KEY ))
  if [[ $KEY_ACTIONS -gt 1 ]]; then
    print_error "--set-key, --get-key and --clear-key are separate actions"
    exit 1
  fi
  if [[ $KEY_ACTIONS -eq 1 ]]; then
    if [[ ${#ARGS[@]} -gt 0 ]]; then
      print_error "a key action takes no other arguments"
      exit 1
    fi
    if [[ $DO_SET_KEY -eq 1 ]]; then
      if [[ -z "$SET_KEY" ]]; then
        check_openssl
        SET_KEY="$(gen_key "$MIN_STORED_KEY")"
        write_stored_key "$SET_KEY" || exit 1
        print_info "generated a new key and stored it"
        echo "$SET_KEY"
      else
        write_stored_key "$SET_KEY" || exit 1
        print_info "key stored"
      fi
      exit 0
    fi
    if [[ $DO_GET_KEY -eq 1 ]]; then
      THE_KEY="$(read_stored_key)"
      if [[ -z "$THE_KEY" ]]; then
        print_error "no key is set on this machine"
        exit 1
      fi
      echo "$THE_KEY"
      exit 0
    fi
    if [[ -e "$KEY_PATH" ]]; then
      rm -f "$KEY_PATH"
      print_info "key cleared"
    else
      print_info "no key was set"
    fi
    exit 0
  fi

  return 0
}

# Load the stored key unless -z was given.
resolve_stored_key() {
  # -z opts out of the stored key, restoring the per-backend default.
  STORED_KEY=""
  if [[ $NOKEY -eq 0 ]]; then
    STORED_KEY="$(read_stored_key)"
  fi

  return 0
}

# Validate flag combinations and pick the encryption mode.
configure_upload() {
  if [[ $ACCUM -eq 1 && $SEND -eq 1 ]]; then
    print_error "-a and -s do opposite things"
    exit 1
  fi

  LBTIME="$(litterbox_time_bucket "$LBHOURS")"

  # WCP_PLAIN=1 env var also opts out of encryption
  if [[ "${WCP_PLAIN:-0}" == "1" ]]; then
    PLAIN=1
  fi

  # A key shorter than 12 chars drops under ~71 bits, which is too weak to store.
  if [[ ! "$KEY_LEN" =~ ^[0-9]+$ ]] || [[ "$KEY_LEN" -lt 12 || "$KEY_LEN" -gt 64 ]]; then
    print_error "--key-len must be a whole number from 12 to 64 (default 12)"
    exit 1
  fi

  # Select the encryption mode for this upload.
  if [[ $PLAIN -eq 1 ]]; then
    ENCRYPT=0
  elif [[ $EXPLICIT_ENCRYPT -eq 1 ]]; then
    ENCRYPT=1
  elif [[ -n "$STORED_KEY" ]]; then
    ENCRYPT=1
  elif [[ "$BACKEND" == "litterbox" ]]; then
    ENCRYPT=0
  else
    ENCRYPT=1
  fi


  return 0
}

# Explicit Retrieval

do_explicit_retrieve() {
  local code="$1" override_out="${2:-}"
  local letter="${code:0:1}"

  # Check if this is an encrypted code (contains '-')
  local enc_key=""
  local actual_code="$code"
  if [[ "$code" == *-* ]]; then
    actual_code="${code%%-*}"
    enc_key="${code#*-}"
  fi

  # Validate prefix letter
  local backend_name=""
  case "$letter" in
    a|b|c|d|e|f|g|h|i|j|k|l|m|n|o) backend_name="litterbox" ;;
    A|B|C|D|E|F|G|H|I|J|K|L|M|N|O) backend_name="catbox" ;;
    0) backend_name="litterbox" ;;
    1) backend_name="catbox" ;;
    *)
      print_error "'${code}' is not a valid code (unknown prefix '${letter}')"
      return 1
      ;;
  esac

  # Determine extension for error message
  local ext_str=""
  if [[ "$letter" =~ [a-z] ]]; then
    local i=$(( $(printf '%d' "'$letter") - 97 ))
    if [[ $i -lt ${#EXT_TABLE[@]} ]]; then
      ext_str=".${EXT_TABLE[$i]}"
    fi
  elif [[ "$letter" =~ [A-Z] ]]; then
    local i=$(( $(printf '%d' "'$letter") - 65 ))
    if [[ $i -lt ${#EXT_TABLE[@]} ]]; then
      ext_str=".${EXT_TABLE[$i]}"
    fi
  else
    ext_str=".txt"
  fi

  if [[ -z "$ext_str" ]]; then
    ext_str=".txt"
  fi

  # Resolve fetch host
  local fetch_host
  if [[ -n "$HOST" ]]; then
    fetch_host="$HOST"
  elif [[ "$backend_name" == "catbox" ]]; then
    fetch_host="$DEFAULT_FETCH_HOST_CATBOX"
  else
    fetch_host="$DEFAULT_FETCH_HOST_LITTERBOX"
  fi

  # Decode the code to get the ID
  if ! decode_code "$actual_code"; then
    print_error "'${code}' is not a valid code (unknown prefix '${letter}')"
    return 1
  fi

  if [[ -n "$enc_key" ]]; then
    # Encrypted retrieval
    check_openssl
    local hdrfile bodyfile http_code
    hdrfile="$(mktemp)"
    bodyfile="$(mktemp)"
    http_code="$(curl -sSL -D "$hdrfile" -o "$bodyfile" \
      -w '%{http_code}' "${fetch_host%/}/${DECODED_ID}")"
    if [[ "$http_code" -ge 400 ]]; then
      rm -f "$hdrfile" "$bodyfile"
      code_not_found "$actual_code" "$backend_name" "$ext_str"
      return 1
    fi
    rm -f "$hdrfile"

    if ! decrypt_and_emit "$enc_key" "$bodyfile" "$override_out"; then
      rm -f "$bodyfile"
      return 1
    fi
    rm -f "$bodyfile"
  else
    if ! retrieve_url "${fetch_host%/}/${DECODED_ID}" "$override_out"; then
      code_not_found "$code" "$backend_name" "$ext_str"
      return 1
    fi
  fi
  return 0
}

# Retrieve if the args name a code or URL; return 1 to fall through.
try_retrieval() {
  target=""
  retrieval_key=""
  if [[ "${ARGS[0]:-}" == "." ]]; then
    target="${ARGS[1]:-}"
    retrieval_key="${ARGS[2]:-}"
    if [[ -z "$target" ]]; then
      print_error ". needs a code or URL, e.g. wcp . b0ojyr4"
      exit 1
    fi
    # Extract key from URL fragment if present
    if [[ "$target" == *"#"* ]]; then
      retrieval_key="${target##*#}"
      target="${target%%#*}"
    fi
    # Validate key if provided
    if [[ -n "$retrieval_key" ]]; then
      if [[ ! "$retrieval_key" =~ ^[A-Za-z0-9]{12,64}$ ]]; then
        print_error "that does not look like a key (expected 12-64 letters and digits)"
        exit 1
      fi
    fi
  elif [[ -n "$OUT_FILE" && ${#ARGS[@]} -eq 1 ]]; then
    target="${ARGS[0]}"
  fi

  if [[ -n "$target" ]]; then
    if [[ "$target" == http://* || "$target" == https://* ]]; then
      if [[ -n "$retrieval_key" ]]; then
        hdrfile="$(mktemp)"
        bodyfile="$(mktemp)"
        http_code="$(curl -sSL -D "$hdrfile" -o "$bodyfile" -w '%{http_code}' "$target")"
        if [[ "$http_code" -ge 400 ]]; then
          rm -f "$hdrfile" "$bodyfile"
          print_error "failed to fetch $target"
          exit 1
        fi
        check_openssl
        rm -f "$hdrfile"
        if ! decrypt_and_emit "$retrieval_key" "$bodyfile" "$OUT_FILE"; then
          rm -f "$bodyfile"
          exit 1
        fi
        rm -f "$bodyfile"
      else
        if ! retrieve_url "$target" "$OUT_FILE"; then
          print_error "failed to fetch $target"
          exit 1
        fi
      fi
    elif [[ -n "$retrieval_key" ]]; then
      # A bare code plus a key: same thing as CODE-KEY, so reuse that path.
      if [[ "$target" == *-* ]]; then
        print_error "'$target' already carries a key, so a second one is ambiguous"
        exit 1
      fi
      if ! do_explicit_retrieve "${target}-${retrieval_key}" "$OUT_FILE"; then
        exit 1
      fi
    elif ! do_explicit_retrieve "$target" "$OUT_FILE"; then
      exit 1
    fi
    exit 0
  fi

  if [[ $PASTE -eq 1 ]]; then
    if [[ ${#ARGS[@]} -gt 0 ]]; then
      print_error "-v/--paste takes no arguments (it uploads the clipboard)"
      exit 1
    fi
    PASTE_TMP="$(mktemp /tmp/wcp-clip.XXXXXX)"
    if ! do_paste > "$PASTE_TMP" 2>/dev/null; then
      rm -f "$PASTE_TMP"
      print_error "-v found no clipboard tool; install $(clip_hint)"
      exit 1
    fi
    if [[ ! -s "$PASTE_TMP" ]]; then
      rm -f "$PASTE_TMP"
      print_error "clipboard is empty — nothing to upload"
      exit 1
    fi
    # Hand it to the existing stdin path. The fd survives the unlink.
    exec < "$PASTE_TMP"
    rm -f "$PASTE_TMP"
  fi

  # Pipe command capture: do this NOW, before reading any stdin.
  PIPE_CMD=""
  pipe_writer_cmd


  # Short Code Retrieval

  if [[ ${#ARGS[@]} -eq 1 && ! -f "${ARGS[0]}" ]]; then
    CANDIDATE="${ARGS[0]}"
    LETTER="${CANDIDATE:0:1}"
    REST="${CANDIDATE:1}"

    # Check if this looks like an encrypted code (contains '-')
    ENC_KEY=""
    ACTUAL_CANDIDATE="$CANDIDATE"
    if [[ "$CANDIDATE" == *-* ]]; then
      ACTUAL_CANDIDATE="${CANDIDATE%%-*}"
      ENC_KEY="${CANDIDATE#*-}"
      REST="${ACTUAL_CANDIDATE:1}"
    fi

    # Try to decode as a new-format code
    if decode_code "$ACTUAL_CANDIDATE"; then
      # Codes of 7 chars or fewer are tried; longer ones need a . or -
      local_cand_len=${#CANDIDATE}
      shape_ok=0
      if [[ $local_cand_len -le 7 ]]; then
        if [[ "$REST" =~ ^[0-9a-zA-Z]{5,12}$ ]]; then
          shape_ok=1
        fi
      else
        if [[ "$CANDIDATE" == *.* || "$CANDIDATE" == *-* ]]; then
          if [[ "$REST" =~ ^[0-9a-zA-Z]{5,12}$ ]]; then
            shape_ok=1
          fi
        fi
      fi
      if [[ $shape_ok -eq 1 ]]; then
        # Resolve fetch host from decoded backend
        if [[ -n "$HOST" ]]; then
          FETCH_HOST="$HOST"
        elif [[ "$DECODED_BACKEND" == "catbox" ]]; then
          FETCH_HOST="$DEFAULT_FETCH_HOST_CATBOX"
        else
          FETCH_HOST="$DEFAULT_FETCH_HOST_LITTERBOX"
        fi
        if [[ -n "$ENC_KEY" ]]; then
          # Encrypted retrieval — do NOT fall back to upload on 404
          check_openssl
          enc_hdrfile="$(mktemp)"
          enc_bodyfile="$(mktemp)"
          enc_http_code="$(curl -sSL -D "$enc_hdrfile" -o "$enc_bodyfile" \
            -w '%{http_code}' "${FETCH_HOST%/}/${DECODED_ID}")"
          if [[ "$enc_http_code" -ge 400 ]]; then
            rm -f "$enc_hdrfile" "$enc_bodyfile"
            code_not_found "$ACTUAL_CANDIDATE" "$DECODED_BACKEND" ""
            exit 1
          fi
          rm -f "$enc_hdrfile"

          if ! decrypt_and_emit "$ENC_KEY" "$enc_bodyfile"; then
            rm -f "$enc_bodyfile"
            exit 1
          fi
          rm -f "$enc_bodyfile"
          exit 0
        else
          if retrieve_url "${FETCH_HOST%/}/${DECODED_ID}"; then
            exit 0
          fi
        fi
        # else: fall through to upload (only for non-encrypted)
      elif [[ "$ACTUAL_CANDIDATE" == *.* ]]; then
        # Escape-path code: the literal .ext follows the id.
        if [[ -n "$HOST" ]]; then
          FETCH_HOST="$HOST"
        elif [[ "$DECODED_BACKEND" == "catbox" ]]; then
          FETCH_HOST="$DEFAULT_FETCH_HOST_CATBOX"
        else
          FETCH_HOST="$DEFAULT_FETCH_HOST_LITTERBOX"
        fi
        if [[ -n "$ENC_KEY" ]]; then
          # Encrypted retrieval — do NOT fall back to upload on 404
          check_openssl
          enc_hdrfile="$(mktemp)"
          enc_bodyfile="$(mktemp)"
          enc_http_code="$(curl -sSL -D "$enc_hdrfile" -o "$enc_bodyfile" \
            -w '%{http_code}' "${FETCH_HOST%/}/${DECODED_ID}")"
          if [[ "$enc_http_code" -ge 400 ]]; then
            rm -f "$enc_hdrfile" "$enc_bodyfile"
            code_not_found "$ACTUAL_CANDIDATE" "$DECODED_BACKEND" ""
            exit 1
          fi
          rm -f "$enc_hdrfile"

          if ! decrypt_and_emit "$ENC_KEY" "$enc_bodyfile"; then
            rm -f "$enc_bodyfile"
            exit 1
          fi
          rm -f "$enc_bodyfile"
          exit 0
        else
          if retrieve_url "${FETCH_HOST%/}/${DECODED_ID}"; then
            exit 0
          fi
        fi
      fi
    fi
  fi

  case "$BACKEND" in
    catbox)      DEFAULT_HOST="$DEFAULT_UPLOAD_HOST_CATBOX" ;;
    litterbox)   DEFAULT_HOST="$DEFAULT_UPLOAD_HOST_LITTERBOX" ;;
    *)
      print_error "unknown backend: $BACKEND (expected: catbox, litterbox)"
      exit 1
      ;;
  esac
  HOST_FOR_FETCH="$HOST"
  [[ -z "$HOST" ]] && HOST="$DEFAULT_HOST"
  HOST="${HOST%/}"

  # Pick a clipboard tool matching the display server, detaching its stdio.
  do_copy() {
    local text="$1" quiet="${2:-}" rc=0
    if command -v pbcopy &>/dev/null; then
      printf '%s' "$text" | pbcopy >/dev/null 2>&1 || rc=$?
    elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &>/dev/null; then
      printf '%s' "$text" | wl-copy >/dev/null 2>&1 || rc=$?
    elif [[ -n "${DISPLAY:-}" ]] && command -v xclip &>/dev/null; then
      printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1 || rc=$?
    elif [[ -n "${DISPLAY:-}" ]] && command -v xsel &>/dev/null; then
      printf '%s' "$text" | xsel --clipboard --input >/dev/null 2>&1 || rc=$?
    else
      if [[ -z "$quiet" ]]; then
        print_warn "-c found no usable clipboard tool; install $(clip_hint)"
      fi
      return 0
    fi
    if [[ $rc -ne 0 && -z "$quiet" ]]; then
      print_warn "-c could not reach the clipboard (tool exited $rc)"
    fi
  }

  # Copy by default on a terminal; only -c reports when the clipboard is unusable.
  maybe_copy() {
    local text="$1"
    if [[ $NO_COPY -eq 1 ]]; then
      return 0
    fi
    if [[ $COPY -eq 1 ]]; then
      do_copy "$text"
    elif [[ -t 1 ]]; then
      do_copy "$text" quiet
    fi
  }


  # Summarise a backend reply, collapsing an HTML error page to one line.
  describe_reply() {
    local r="$1" title req
    if [[ -z "$r" ]]; then
      printf '<empty response>'
      return
    fi
    if [[ "$r" == *"<html"* || "$r" == *"<!doctype"* || "$r" == *"<!DOCTYPE"* ]]; then
      title="$(printf '%s' "$r" | grep -o '<title>[^<]*' | head -1 | sed 's/<title>//')"
      req="$(printf '%s' "$r" | grep -o 'Request ID: <code>[^<]*' | head -1 \
        | sed 's/.*<code>//')"
      printf 'HTML error page'
      [[ -n "$title" ]] && printf ' - %s' "$title"
      [[ -n "$req" ]] && printf ' (request id %s)' "$req"
      return
    fi
    printf '%.200s' "$r"
    [[ ${#r} -gt 200 ]] && printf '... [%s bytes total]' "${#r}"
  }

  # Print the code or link, and copy the part the user would paste.
  emit_result() {
    local id_full="$1" backend="$2" key="${3:-}"
    local code
    code="$(encode_id "$id_full" "$backend")"
    if [[ $LINK -eq 1 ]]; then
      local fetch_url
      if [[ -n "$HOST_FOR_FETCH" ]]; then
        fetch_url="${HOST_FOR_FETCH%/}/${id_full}"
      elif [[ "$backend" == "catbox" ]]; then
        fetch_url="${DEFAULT_FETCH_HOST_CATBOX}/${id_full}"
      else
        fetch_url="${DEFAULT_FETCH_HOST_LITTERBOX}/${id_full}"
      fi
      echo "$fetch_url"
      maybe_copy "$fetch_url"
      if [[ -n "$key" ]]; then
        echo "$key"
      fi
    elif [[ -n "$key" ]]; then
      echo "${code}-${key}"
      maybe_copy "${code}-${key}"
    else
      echo "$code"
      maybe_copy "$code"
    fi
  }


  return 0
}

# Backends

up_catbox_file()  { curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${1}" "$HOST"; }
up_catbox_text() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  printf '%s' "$1" > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}
up_catbox_stdin() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  cat > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}

# backend: litterbox (POST, multipart reqtype=fileupload + time)
up_litterbox_file() {
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" \
    -F "fileToUpload=@${1}" "$HOST"
}
up_litterbox_text() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  printf '%s' "$1" > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}
up_litterbox_stdin() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  cat > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}

dispatch() {
  local kind="$1" # file | text | stdin
  local arg="${2:-}"
  case "$BACKEND" in
    catbox)
      case "$kind" in
        file)  up_catbox_file "$arg" ;;
        text)  up_catbox_text "$arg" ;;
        stdin) up_catbox_stdin ;;
      esac
      ;;
    litterbox)
      case "$kind" in
        file)  up_litterbox_file "$arg" ;;
        text)  up_litterbox_text "$arg" ;;
        stdin) up_litterbox_stdin ;;
      esac
      ;;
  esac
}

# Warn on permanent plaintext, then handle --clear, -a and -s.
run_buffer_action() {
  if [[ $ENCRYPT -eq 0 && "$BACKEND" == "catbox" ]] \
     && [[ $PLAIN -eq 1 || $NOKEY -eq 1 ]]; then
    print_warn "uploading to catbox UNENCRYPTED - catbox never expires"
  fi

  # Accumulate / Send / Drop
  if [[ $CLEAR -eq 1 ]]; then
    if [[ -f "$BUFFER_PATH" ]]; then
      entries=$(count_entries "$BUFFER_PATH")
      sz="$(human_size "$(wc -c < "$BUFFER_PATH")")"
      rm -f "$BUFFER_PATH"
      print_info "buffer cleared ($(plural_entries "$entries"), $sz)"
    else
      print_info "buffer cleared (0 entries, 0 B)"
    fi
    exit 0
  fi

  if [[ $ACCUM -eq 1 ]]; then
    if [[ ${#ARGS[@]} -gt 0 ]]; then
      text="${ARGS[*]}"
      if [[ -f "$BUFFER_PATH" && -s "$BUFFER_PATH" ]]; then
        printf '\n\n%s\n' "$text" >> "$BUFFER_PATH"
      else
        mkdir -p "$(dirname "$BUFFER_PATH")"
        printf '%s\n' "$text" >> "$BUFFER_PATH"
      fi
    elif [[ -t 0 ]]; then
      show_buffer
    else
      local_tmp="$(mktemp /tmp/wcp-accum.XXXXXX)"
      cat > "$local_tmp"
      raw_sz="$(wc -c < "$local_tmp")"
      if [[ "$raw_sz" -eq 0 ]]; then
        rm -f "$local_tmp"
        show_buffer
        exit 0
      fi
      # A NUL proves binary, but short binary often has none, so ask file(1) too.
      clean_sz="$(tr -d '\0' < "$local_tmp" | wc -c)"
      is_binary=0
      [[ "$raw_sz" -ne "$clean_sz" ]] && is_binary=1
      if [[ $is_binary -eq 0 ]] && command -v file &>/dev/null; then
        [[ "$(file -b --mime-encoding "$local_tmp" 2>/dev/null)" == "binary" ]] \
          && is_binary=1
      fi
      if [[ $is_binary -eq 1 ]]; then
        rm -f "$local_tmp"
        print_error "only text can be accumulated"
        exit 1
      fi
      content="$(cat "$local_tmp")"
      rm -f "$local_tmp"
      if [[ -n "$PIPE_CMD" ]]; then
        entry="\$ $PIPE_CMD
  $content"
      else
        entry="$content"
      fi
      if [[ -f "$BUFFER_PATH" && -s "$BUFFER_PATH" ]]; then
        printf '\n\n%s\n' "$entry" >> "$BUFFER_PATH"
      else
        mkdir -p "$(dirname "$BUFFER_PATH")"
        printf '%s\n' "$entry" >> "$BUFFER_PATH"
      fi
    fi
    exit 0
  fi

  if [[ $SEND -eq 1 ]]; then
    if [[ ! -f "$BUFFER_PATH" || ! -s "$BUFFER_PATH" ]]; then
      print_error "buffer is empty - nothing to send"
      exit 1
    fi
    buffer_content="$(cat "$BUFFER_PATH")"
    KEY=""
    if [[ $ENCRYPT -eq 1 ]]; then
      check_openssl
      select_key
      TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
      printf '%s' "$buffer_content" | encrypt_content "$KEY" > "$TMPF"
      ENC_CONTENT="$(cat "$TMPF")"
      rm -f "$TMPF"
      RESULT="$(dispatch text "$ENC_CONTENT")"
    else
      RESULT="$(dispatch text "$buffer_content")"
    fi
    if [[ "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
      ID_FULL="$(strip_host "$RESULT")"
      emit_result "$ID_FULL" "$BACKEND" "$EMIT_KEY"
      rm -f "$BUFFER_PATH"
    else
      print_error "upload failed on backend '$BACKEND' ($HOST)"
      print_error "backend reply: $(describe_reply "$RESULT")"
      exit 1
    fi
    exit 0
  fi

  return 0
}

# Upload stdin, a file or the argument text, then print the code.
do_upload() {
  if [[ ${#ARGS[@]} -eq 0 || ( ${#ARGS[@]} -eq 1 && "${ARGS[0]}" == "-" ) ]]; then
    # Announce that we are waiting on stdin.
    if [[ -t 0 ]]; then
      print_info "reading stdin — paste or type, then Ctrl-D to send (Ctrl-C cancels)"
    fi
    # Buffer stdin so empty input is rejected before uploading.
    STDIN_TMP="$(mktemp /tmp/wcp-stdin.XXXXXX)"
    cat > "$STDIN_TMP"
    if [[ ! -s "$STDIN_TMP" ]]; then
      rm -f "$STDIN_TMP"
      print_error "nothing on stdin — nothing to upload"
      exit 1
    fi
    exec < "$STDIN_TMP"
    rm -f "$STDIN_TMP"
    if [[ $ENCRYPT -eq 1 ]]; then
      check_openssl
      select_key
      TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
      cat | encrypt_content "$KEY" > "$TMPF"
      ENC_CONTENT="$(cat "$TMPF")"
      rm -f "$TMPF"
      RESULT="$(dispatch text "$ENC_CONTENT")"
      if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
        print_error "upload failed on backend '$BACKEND' ($HOST)"
        print_error "backend reply: $(describe_reply "$RESULT")"
        exit 1
      fi
      ID_FULL="$(strip_host "$RESULT")"
      emit_result "$ID_FULL" "$BACKEND" "$EMIT_KEY"
      exit 0
    else
      RESULT="$(dispatch stdin)"
    fi
  elif [[ ${#ARGS[@]} -eq 1 && -f "${ARGS[0]}" ]]; then
    if [[ $ENCRYPT -eq 1 ]]; then
      check_openssl
      FPATH="${ARGS[0]}"
      FSIZE="$(stat -c%s "$FPATH" 2>/dev/null || stat -f%z "$FPATH" 2>/dev/null)"
      if [[ "$FSIZE" -le $MAX_ENC_SIZE ]]; then
        select_key
        FNAME="$(basename "$FPATH")"
        TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
        { printf 'wcp-name:%s\n' "$FNAME"; cat "$FPATH"; } \
          | encrypt_content "$KEY" > "$TMPF"
        ENC_CONTENT="$(cat "$TMPF")"
        rm -f "$TMPF"
        RESULT="$(dispatch text "$ENC_CONTENT")"
        if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
          print_error "upload failed on backend '$BACKEND' ($HOST)"
          print_error "backend reply: $(describe_reply "$RESULT")"
          exit 1
        fi
        ID_FULL="$(strip_host "$RESULT")"
        emit_result "$ID_FULL" "$BACKEND" "$EMIT_KEY"
        exit 0
      elif [[ $FORCE -eq 1 ]]; then
        if [[ "$FSIZE" -gt $MAX_FORCE_SIZE ]]; then
          HSIZE="$(human_size "$FSIZE")"
          FLIMIT="$(human_size $MAX_FORCE_SIZE)"
          BN="$(basename "$FPATH")"
          print_error "-f cannot encrypt $BN - $HSIZE over the $FLIMIT encrypted limit"
          print_error "upload it without -f to send it unencrypted"
          exit 1
        fi
        HSIZE="$(human_size "$FSIZE")"
        UP_SIZE="$(( FSIZE * 4 / 3 ))"
        HUP="$(human_size "$UP_SIZE")"
        echo "wcp: encrypting $HSIZE" \
          "- the upload will be about $HUP and may take a while" >&2
        select_key
        FNAME="$(basename "$FPATH")"
        TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
        { printf 'wcp-name:%s\n' "$FNAME"; cat "$FPATH"; } \
          | encrypt_content "$KEY" > "$TMPF"
        ENC_CONTENT="$(cat "$TMPF")"
        rm -f "$TMPF"
        RESULT="$(dispatch text "$ENC_CONTENT")"
        if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
          print_error "upload failed on backend '$BACKEND' ($HOST)"
          print_error "backend reply: $(describe_reply "$RESULT")"
          exit 1
        fi
        ID_FULL="$(strip_host "$RESULT")"
        emit_result "$ID_FULL" "$BACKEND" "$EMIT_KEY"
        exit 0
      else
        HSIZE="$(human_size "$FSIZE")"
        LIMIT="$(human_size $MAX_ENC_SIZE)"
        BN="$(basename "$FPATH")"
        print_warn "not encrypting $BN - $HSIZE over the $LIMIT limit, uploading as-is"
        print_warn "pass -f to encrypt it anyway"
        RESULT="$(dispatch file "$FPATH")"
      fi
    else
      RESULT="$(dispatch file "${ARGS[0]}")"
    fi
  else
    if [[ $ENCRYPT -eq 1 ]]; then
      check_openssl
      select_key
      TEXT="${ARGS[*]}"
      TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
      printf '%s' "$TEXT" | encrypt_content "$KEY" > "$TMPF"
      ENC_CONTENT="$(cat "$TMPF")"
      rm -f "$TMPF"
      RESULT="$(dispatch text "$ENC_CONTENT")"
      if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
        print_error "upload failed on backend '$BACKEND' ($HOST)"
        print_error "backend reply: $(describe_reply "$RESULT")"
        exit 1
      fi
      ID_FULL="$(strip_host "$RESULT")"
      emit_result "$ID_FULL" "$BACKEND" "$EMIT_KEY"
      exit 0
    else
      TEXT="${ARGS[*]}"
      RESULT="$(dispatch text "$TEXT")"
    fi
  fi

  if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
    print_error "upload failed on backend '$BACKEND' ($HOST)"
    print_error "backend reply: $(describe_reply "$RESULT")"
    exit 1
  fi

  ID_FULL="$(strip_host "$RESULT")"
  emit_result "$ID_FULL" "$BACKEND"
}


# Run

main() {
  parse_args "$@"
  require_tools

  if [[ $DO_RUN_TESTS -eq 1 ]]; then
    WCP_BIN="$(readlink -f "$0")"
    run_tests "$TEST_SHEET"
    exit $?
  fi

  run_key_action
  resolve_stored_key
  configure_upload
  try_retrieval
  run_buffer_action
  do_upload
}

main "$@"
