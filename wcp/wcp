#!/usr/bin/env bash
# wcp — minimal upload wrapper with a compact roundtrip code.
#
# USAGE:
#   wcp path/to/file.txt        # upload -> prints a short code, e.g. "brbkswy"
#   wcp some words here         # not a file -> uploaded as text, prints a code
#   echo "text" | wcp           # no args -> reads stdin, prints a code
#   wcp brbkswy                 # retrieve (implicit): may fall back to uploading
#   wcp . brbkswy               # retrieve (explicit): errors instead of falling back
#   wcp . <full-url>            # retrieve by URL instead of a code
#   wcp . brbkswy -o out.txt    # ...saved under a name you choose
#
# Retrieved text prints to stdout; retrieved files are saved into the current
# folder. Existing files are never overwritten — _1, _2 are appended and the
# name actually used is printed. Encrypted files restore their original name.
#
# The first character of the printed code encodes BOTH the backend and the
# file extension. Lowercase a-o = litterbox, uppercase A-O = catbox.
# Digits 0/1 mean the extension is not in the built-in table (the literal
# .ext follows the prefix). A typical code is 7 characters long.
# Letters p-z, P-Z and digits 2-9 are reserved for a future third backend.
#
# -b / --backend and --host work for both directions: on upload they choose
# which service and endpoint is used; on retrieval, --host overrides the
# default fetch host for the decoded backend.
#
# -t [hours] takes a whole number of hours and rounds UP to the nearest of
# 1h, 12h, 24h, 72h (litterbox only; catbox never expires). Max 72h.
#
# Env vars: WCP_BACKEND (default: litterbox), WCP_TIME (whole hours, default 1)
#
# Collision handling: a candidate of 7 chars or fewer that looks like a code is
# tried as a retrieval first; if that 404s it falls back to uploading it as
# text. Longer candidates are only tried if they contain a . or a - (escape and
# escape-path codes carry a dot, encrypted codes a dash), so an ordinary long
# word is uploaded straight away with no wasted request.
#
# Encryption default depends on the backend: litterbox uploads are plain
# (they expire, so exposure is short); every other backend is encrypted.
# -e / --encrypt forces it on; --plain / -p and WCP_PLAIN=1 force it off.
# Encrypted codes use a 12-char alphanumeric key: CODE-KEY (~20 chars total).
# The KEY is NEVER uploaded — only the ciphertext goes to the server.
# Losing the KEY loses the data permanently.
#   wcp -b c hello world -> B0ojyr4-AbCdEfGhIjKl
# openssl is needed only when encrypting; the litterbox default does not use it.
# Files up to 1 MB are encrypted, any type; larger ones upload as-is with a warning.
# Short aliases: -b backend, -c copy, -e encrypt, -p plain, -t time.
set -euo pipefail

DEFAULT_UPLOAD_HOST_CATBOX="https://catbox.moe/user/api.php"
DEFAULT_FETCH_HOST_CATBOX="https://files.catbox.moe"
DEFAULT_UPLOAD_HOST_LITTERBOX="https://litterbox.catbox.moe/resources/internals/api.php"
DEFAULT_FETCH_HOST_LITTERBOX="https://litter.catbox.moe"
DEFAULT_LITTERBOX_TIME="1h"

# Extension table: index 0 = no extension, 1..14 = common extensions.
EXT_TABLE=( "" txt md log json yaml csv conf sh py png jpg pdf zip gz )

encode_id() {
  local id_full="$1" backend="$2"
  local id_base ext prefix

  # Split on the LAST dot
  if [[ "$id_full" == *.* ]]; then
    ext="${id_full##*.}"
    id_base="${id_full%.*}"
  else
    id_base="$id_full"
    ext=""
  fi

  # Look up ext in EXT_TABLE
  local found=0 i
  for i in "${!EXT_TABLE[@]}"; do
    if [[ "${EXT_TABLE[$i]}" == "$ext" ]]; then
      found=1
      if [[ "$backend" == "catbox" ]]; then
        # uppercase: A=0, B=1, ...
        printf -v prefix '%b' "\\$(printf '%03o' $((65 + i)))"
      else
        # lowercase: a=0, b=1, ...
        printf -v prefix '%b' "\\$(printf '%03o' $((97 + i)))"
      fi
      echo "${prefix}${id_base}"
      return
    fi
  done

  # Not found: use 0 for litterbox, 1 for catbox, keep literal .ext
  if [[ "$backend" == "catbox" ]]; then
    echo "1${id_base}.${ext}"
  else
    echo "0${id_base}.${ext}"
  fi
}

decode_code() {
  local candidate="$1"
  local letter="${candidate:0:1}"
  local rest="${candidate:1}"

  # Digit prefix: extension is not in the table, REST holds the literal .ext.
  if [[ "$letter" == "0" || "$letter" == "1" ]]; then
    if [[ "$letter" == "0" ]]; then
      DECODED_BACKEND="litterbox"
    else
      DECODED_BACKEND="catbox"
    fi
    DECODED_ID="$rest"
    return 0
  fi

  # Alphabetic prefix: look the extension up in the table.
  local i
  if [[ "$letter" =~ [a-z] ]]; then
    DECODED_BACKEND="litterbox"
    i=$(( $(printf '%d' "'$letter") - 97 ))
  elif [[ "$letter" =~ [A-Z] ]]; then
    DECODED_BACKEND="catbox"
    i=$(( $(printf '%d' "'$letter") - 65 ))
  else
    return 1
  fi

  if [[ $i -lt 0 || $i -ge ${#EXT_TABLE[@]} ]]; then
    return 1
  fi

  local ext="${EXT_TABLE[$i]}"
  if [[ -z "$ext" ]]; then
    DECODED_ID="$rest"
  else
    DECODED_ID="${rest}.${ext}"
  fi
  return 0
}

litterbox_time_bucket() {
  local h="${1%h}"
  if [[ ! "$h" =~ ^[0-9]+$ ]] || [[ "$h" -lt 1 ]]; then
    echo "wcp: -t takes a whole number of hours, 1 to 72" >&2
    return 1
  fi
  if   [[ "$h" -le 1  ]]; then echo "1h"
  elif [[ "$h" -le 12 ]]; then echo "12h"
  elif [[ "$h" -le 24 ]]; then echo "24h"
  elif [[ "$h" -le 72 ]]; then echo "72h"
  else
    echo "wcp: -t max is 72 hours (litterbox allows 1, 12, 24, 72)" >&2
    return 1
  fi
}

# Strip scheme://host from a URL, leaving the path as the id.
strip_host() {
  local url="$1"
  url="${url#https://}"
  url="${url#http://}"
  url="${url#*/}"
  echo "$url"
}


# Retrieval

retrieve_url() {
  local url="$1"
  local override_out="${2:-}"
  local hdrfile bodyfile ctype http_code
  hdrfile="$(mktemp)"
  bodyfile="$(mktemp)"
  http_code="$(curl -sSL -D "$hdrfile" -o "$bodyfile" -w '%{http_code}' "$url")"

  if [[ "$http_code" -ge 400 ]]; then
    rm -f "$hdrfile" "$bodyfile"
    return 1
  fi

  ctype="$(grep -i '^content-type:' "$hdrfile" | tail -1 \
    | cut -d: -f2- | tr -d '\r' | xargs || true)"

  if [[ -n "$override_out" ]]; then
    local out_name
    out_name="$(unique_save_name "$override_out")"
    mv "$bodyfile" "$out_name"
    echo "Saved to $out_name"
  elif [[ "$ctype" == text/* ]]; then
    emit_text "$bodyfile"
    rm -f "$bodyfile"
  else
    local fname
    fname="$(basename "$url")"
    [[ -z "$fname" || "$fname" == "/" ]] && fname="downloaded_file"
    local save_name
    save_name="$(unique_save_name "./$fname")"
    mv "$bodyfile" "$save_name"
    echo "Saved as $(basename "$save_name")"
  fi
  rm -f "$hdrfile"
  return 0
}


# Helpers

# Name the clipboard package that fits the running display server.
clip_hint() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "wl-clipboard"
  elif [[ -n "${DISPLAY:-}" ]]; then
    echo "xclip"
  else
    echo "a clipboard tool, but this session has no display"
  fi
}

# Read the clipboard. Returns 2 when no clipboard tool exists.
do_paste() {
  if command -v pbpaste &>/dev/null; then
    pbpaste
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-paste &>/dev/null; then
    wl-paste --no-newline 2>/dev/null
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip &>/dev/null; then
    xclip -selection clipboard -o 2>/dev/null
  elif [[ -n "${DISPLAY:-}" ]] && command -v xsel &>/dev/null; then
    xsel --clipboard --output 2>/dev/null
  else
    return 2
  fi
}

# Print retrieved text, adding a trailing newline only on a terminal.
emit_text() {
  local f="$1"
  cat "$f"
  if [[ -t 1 && -s "$f" && $(tail -c1 "$f" | wc -l) -eq 0 ]]; then
    echo
  fi
}

code_not_found() {
  local code="$1" backend="$2" ext="$3"
  echo "wcp: no such code '${code}' (${backend}, ${ext:-no extension})" >&2
  if [[ "$backend" == "litterbox" ]]; then
    echo "wcp: litterbox codes expire — the default window is 1h" >&2
  fi
}

check_openssl() {
  if ! command -v openssl &>/dev/null; then
    echo "wcp: -e needs openssl, which was not found on this system" >&2
    echo "wcp: install it (e.g. apt install openssl) or drop -e" >&2
    exit 1
  fi
}

encrypt_content() {
  local key="$1"
  openssl enc -aes-256-cbc -pbkdf2 -iter 10000 -salt -pass "pass:$key" | base64 -w0
}

decrypt_content() {
  local key="$1"
  base64 -d | openssl enc -d -aes-256-cbc -pbkdf2 -iter 10000 -pass "pass:$key"
}

human_size() {
  local bytes="$1"
  if [[ $bytes -ge 1048576 ]]; then
    echo "$(( bytes / 1048576 )) MB"
  elif [[ $bytes -ge 1024 ]]; then
    echo "$(( (bytes + 512) / 1024 )) KB"
  else
    echo "${bytes} B"
  fi
}

# Append _1, _2 before the extension until the name is free.
unique_save_name() {
  local base="$1"
  if [[ ! -e "$base" ]]; then
    echo "$base"
    return
  fi
  local name ext
  if [[ "$base" == *.* ]]; then
    ext="${base##*.}"
    name="${base%.*}"
  else
    ext=""
    name="$base"
  fi
  local i=1
  while true; do
    local candidate
    if [[ -n "$ext" ]]; then
      candidate="${name}_${i}.${ext}"
    else
      candidate="${name}_${i}"
    fi
    if [[ ! -e "$candidate" ]]; then
      echo "$candidate"
      return
    fi
    i=$((i + 1))
  done
}

KEY_LEN="${WCP_KEY_LEN:-12}"
MAX_ENC_SIZE=1048576

# Build a KEY_LEN key from [A-Za-z0-9], failing if it is malformed.
gen_key() {
  local k=""
  while [[ ${#k} -lt $KEY_LEN ]]; do
    k="${k}$(openssl rand -base64 48 | LC_ALL=C tr -dc 'A-Za-z0-9')"
  done
  k="${k:0:$KEY_LEN}"
  if [[ ${#k} -ne $KEY_LEN ]] || [[ "$k" =~ [^A-Za-z0-9] ]]; then
    echo "wcp: internal error — generated key failed its format check" >&2
    return 1
  fi
  printf '%s' "$k"
}

# Decrypt a body, saving under its wcp-name header or printing it.
decrypt_and_emit() {
  local key="$1" bodyfile="$2" override_out="${3:-}"
  local plainfile first_line fname save_name
  plainfile="$(mktemp /tmp/wcp-dec.XXXXXX)"
  if ! decrypt_content "$key" < "$bodyfile" > "$plainfile" 2>/dev/null; then
    rm -f "$plainfile"
    echo "wcp: could not decrypt — the key may be wrong or the upload corrupted" >&2
    return 1
  fi
  IFS= read -r first_line < "$plainfile" || first_line=""
  if [[ -n "$override_out" ]]; then
    local out_name
    out_name="$(unique_save_name "$override_out")"
    if [[ "$first_line" == wcp-name:* ]]; then
      tail -n +2 "$plainfile" > "$out_name"
    else
      cp "$plainfile" "$out_name"
    fi
    echo "Saved to $out_name"
  elif [[ "$first_line" == wcp-name:* ]]; then
    fname="${first_line#wcp-name:}"
    save_name="$(unique_save_name "./$fname")"
    tail -n +2 "$plainfile" > "$save_name"
    echo "Saved as $(basename "$save_name")"
  else
    emit_text "$plainfile"
  fi
  rm -f "$plainfile"
  return 0
}

usage() {
    cat << 'USAGE'
wcp — upload a file, some text, or stdin; get back a short code.

Usage:
  wcp <file>                     upload a file
  wcp some words here            upload text
  echo text | wcp                upload stdin
  wcp                            read stdin; use this for MULTI-LINE text
  wcp <code>                     retrieve; falls back to uploading on a miss
  wcp . <code|url>               retrieve; errors on a miss
  wcp <code|url> -o <file>       retrieve and save under a chosen name

Options:
  -b, --backend <name>   litterbox (default) or catbox; -b l / -b c also work
      --host <url>       override the backend endpoint, or the fetch host
  -t, --time <hours>     litterbox expiry, rounds up to 1/12/24/72 (default 1)
  -e, --encrypt          force client-side encryption
  -p, --plain            force no encryption
  -c, --copy             copy the resulting code to the clipboard
  -k, --key-len <n>      encryption key length, 12 to 64 (default 12)
  -v, --paste            upload the clipboard contents (takes no arguments)
  -h, --help             show this help

Encryption: litterbox is plain because it expires; every other backend is
encrypted. The key travels inside the code and never reaches the server, so
losing the code loses the data. openssl is required only when encrypting.

Multi-line text cannot be passed as arguments: the shell splits a pasted
block on its newlines before wcp runs, so only the first line arrives. Run
bare 'wcp', paste, then press Ctrl-D.

Env: WCP_BACKEND, WCP_TIME (whole hours), WCP_PLAIN=1, WCP_KEY_LEN
USAGE
}


# Flag Parsing

BACKEND="${WCP_BACKEND:-litterbox}"
LBHOURS="${WCP_TIME:-1}"
HOST=""
COPY=0
PASTE=0
OUT_FILE=""
PLAIN=0
ENCRYPT=0
EXPLICIT_ENCRYPT=0
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--backend)
      case "$2" in
        c|catbox)    BACKEND="catbox" ;;
        l|litterbox) BACKEND="litterbox" ;;
        *)           BACKEND="$2" ;;
      esac
      shift 2
      ;;
    --backend=*)
      val="${1#*=}"
      case "$val" in
        c|catbox)    BACKEND="catbox" ;;
        l|litterbox) BACKEND="litterbox" ;;
        *)           BACKEND="$val" ;;
      esac
      shift
      ;;
    --host)
      HOST="$2"
      shift 2
      ;;
    --host=*)
      HOST="${1#*=}"
      shift
      ;;
    -t|--time)
      LBHOURS="$2"
      shift 2
      ;;
    -t=*|--time=*)
      LBHOURS="${1#*=}"
      shift
      ;;
    -c|--copy)
      COPY=1
      shift
      ;;
    -o|--output)
      OUT_FILE="$2"
      shift 2
      ;;
    -k|--key-len)
      KEY_LEN="$2"
      shift 2
      ;;
    --key-len=*)
      KEY_LEN="${1#*=}"
      shift
      ;;
    -v|--paste)
      PASTE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -e|--encrypt)
      EXPLICIT_ENCRYPT=1
      shift
      ;;
    -p|--plain)
      PLAIN=1
      shift
      ;;
    --)
      shift
      ARGS+=("$@")
      break
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

LBTIME="$(litterbox_time_bucket "$LBHOURS")"

# WCP_PLAIN=1 env var also opts out of encryption
if [[ "${WCP_PLAIN:-0}" == "1" ]]; then
  PLAIN=1
fi

# A key shorter than 12 chars drops under ~71 bits, which is too weak to store.
if [[ ! "$KEY_LEN" =~ ^[0-9]+$ ]] || [[ "$KEY_LEN" -lt 12 || "$KEY_LEN" -gt 64 ]]; then
  echo "wcp: --key-len must be a whole number from 12 to 64 (default 12)" >&2
  exit 1
fi

# Select the encryption mode for this upload.
WARN_NO_OPENSSL=0
if [[ $PLAIN -eq 1 ]]; then
  ENCRYPT=0
elif [[ $EXPLICIT_ENCRYPT -eq 1 ]]; then
  if ! command -v openssl &>/dev/null; then
    echo "wcp: -e needs openssl, which was not found on this system" >&2
    echo "wcp: install it (e.g. apt install openssl) or use --plain" >&2
    exit 1
  fi
  ENCRYPT=1
elif [[ "$BACKEND" == "litterbox" ]]; then
  ENCRYPT=0
elif command -v openssl &>/dev/null; then
  ENCRYPT=1
else
  ENCRYPT=0
  WARN_NO_OPENSSL=1
fi


# Explicit Retrieval

do_explicit_retrieve() {
  local code="$1" override_out="${2:-}"
  local letter="${code:0:1}"

  # Check if this is an encrypted code (contains '-')
  local enc_key=""
  local actual_code="$code"
  if [[ "$code" == *-* ]]; then
    actual_code="${code%%-*}"
    enc_key="${code#*-}"
  fi

  # Validate prefix letter
  local backend_name=""
  case "$letter" in
    a|b|c|d|e|f|g|h|i|j|k|l|m|n|o) backend_name="litterbox" ;;
    A|B|C|D|E|F|G|H|I|J|K|L|M|N|O) backend_name="catbox" ;;
    0) backend_name="litterbox" ;;
    1) backend_name="catbox" ;;
    *)
      echo "wcp: '${code}' is not a valid code (unknown prefix '${letter}')" >&2
      return 1
      ;;
  esac

  # Determine extension for error message
  local ext_str=""
  if [[ "$letter" =~ [a-z] ]]; then
    local i=$(( $(printf '%d' "'$letter") - 97 ))
    if [[ $i -lt ${#EXT_TABLE[@]} ]]; then
      ext_str=".${EXT_TABLE[$i]}"
    fi
  elif [[ "$letter" =~ [A-Z] ]]; then
    local i=$(( $(printf '%d' "'$letter") - 65 ))
    if [[ $i -lt ${#EXT_TABLE[@]} ]]; then
      ext_str=".${EXT_TABLE[$i]}"
    fi
  else
    ext_str=".txt"
  fi

  if [[ -z "$ext_str" ]]; then
    ext_str=".txt"
  fi

  # Resolve fetch host
  local fetch_host
  if [[ -n "$HOST" ]]; then
    fetch_host="$HOST"
  elif [[ "$backend_name" == "catbox" ]]; then
    fetch_host="$DEFAULT_FETCH_HOST_CATBOX"
  else
    fetch_host="$DEFAULT_FETCH_HOST_LITTERBOX"
  fi

  # Decode the code to get the ID
  if ! decode_code "$actual_code"; then
    echo "wcp: '${code}' is not a valid code (unknown prefix '${letter}')" >&2
    return 1
  fi

  if [[ -n "$enc_key" ]]; then
    # Encrypted retrieval
    check_openssl
    local hdrfile bodyfile http_code
    hdrfile="$(mktemp)"
    bodyfile="$(mktemp)"
    http_code="$(curl -sSL -D "$hdrfile" -o "$bodyfile" \
      -w '%{http_code}' "${fetch_host%/}/${DECODED_ID}")"
    if [[ "$http_code" -ge 400 ]]; then
      rm -f "$hdrfile" "$bodyfile"
      code_not_found "$actual_code" "$backend_name" "$ext_str"
      return 1
    fi
    rm -f "$hdrfile"

    if ! decrypt_and_emit "$enc_key" "$bodyfile" "$override_out"; then
      rm -f "$bodyfile"
      return 1
    fi
    rm -f "$bodyfile"
  else
    if ! retrieve_url "${fetch_host%/}/${DECODED_ID}" "$override_out"; then
      code_not_found "$code" "$backend_name" "$ext_str"
      return 1
    fi
  fi
  return 0
}

# A leading dot, or -o on its own, both mean an explicit retrieval.
target=""
if [[ "${ARGS[0]:-}" == "." ]]; then
  target="${ARGS[1]:-}"
  if [[ -z "$target" ]]; then
    echo "wcp: . needs a code or URL, e.g. wcp . b0ojyr4" >&2
    exit 1
  fi
elif [[ -n "$OUT_FILE" && ${#ARGS[@]} -eq 1 ]]; then
  target="${ARGS[0]}"
fi

if [[ -n "$target" ]]; then
  if [[ "$target" == http://* || "$target" == https://* ]]; then
    if ! retrieve_url "$target" "$OUT_FILE"; then
      echo "wcp: failed to fetch $target" >&2
      exit 1
    fi
  elif ! do_explicit_retrieve "$target" "$OUT_FILE"; then
    exit 1
  fi
  exit 0
fi

if [[ $PASTE -eq 1 ]]; then
  if [[ ${#ARGS[@]} -gt 0 ]]; then
    echo "wcp: -v/--paste takes no arguments (it uploads the clipboard)" >&2
    exit 1
  fi
  PASTE_TMP="$(mktemp /tmp/wcp-clip.XXXXXX)"
  if ! do_paste > "$PASTE_TMP" 2>/dev/null; then
    rm -f "$PASTE_TMP"
    echo "wcp: -v found no clipboard tool; install $(clip_hint)" >&2
    exit 1
  fi
  if [[ ! -s "$PASTE_TMP" ]]; then
    rm -f "$PASTE_TMP"
    echo "wcp: clipboard is empty — nothing to upload" >&2
    exit 1
  fi
  # Hand it to the existing stdin path. The fd survives the unlink.
  exec < "$PASTE_TMP"
  rm -f "$PASTE_TMP"
fi


# Short Code Retrieval

if [[ ${#ARGS[@]} -eq 1 && ! -f "${ARGS[0]}" ]]; then
  CANDIDATE="${ARGS[0]}"
  LETTER="${CANDIDATE:0:1}"
  REST="${CANDIDATE:1}"

  # Check if this looks like an encrypted code (contains '-')
  ENC_KEY=""
  ACTUAL_CANDIDATE="$CANDIDATE"
  if [[ "$CANDIDATE" == *-* ]]; then
    ACTUAL_CANDIDATE="${CANDIDATE%%-*}"
    ENC_KEY="${CANDIDATE#*-}"
    REST="${ACTUAL_CANDIDATE:1}"
  fi

  # Try to decode as a new-format code
  if decode_code "$ACTUAL_CANDIDATE"; then
    # Shape check: length <= 7 -> current behaviour; length > 7 -> only if contains . or -
    local_cand_len=${#CANDIDATE}
    shape_ok=0
    if [[ $local_cand_len -le 7 ]]; then
      if [[ "$REST" =~ ^[0-9a-zA-Z]{5,12}$ ]]; then
        shape_ok=1
      fi
    else
      if [[ "$CANDIDATE" == *.* || "$CANDIDATE" == *-* ]]; then
        if [[ "$REST" =~ ^[0-9a-zA-Z]{5,12}$ ]]; then
          shape_ok=1
        fi
      fi
    fi
    if [[ $shape_ok -eq 1 ]]; then
      # Resolve fetch host from decoded backend
      if [[ -n "$HOST" ]]; then
        FETCH_HOST="$HOST"
      elif [[ "$DECODED_BACKEND" == "catbox" ]]; then
        FETCH_HOST="$DEFAULT_FETCH_HOST_CATBOX"
      else
        FETCH_HOST="$DEFAULT_FETCH_HOST_LITTERBOX"
      fi
      if [[ -n "$ENC_KEY" ]]; then
        # Encrypted retrieval — do NOT fall back to upload on 404
        check_openssl
        enc_hdrfile="$(mktemp)"
        enc_bodyfile="$(mktemp)"
        enc_http_code="$(curl -sSL -D "$enc_hdrfile" -o "$enc_bodyfile" \
          -w '%{http_code}' "${FETCH_HOST%/}/${DECODED_ID}")"
        if [[ "$enc_http_code" -ge 400 ]]; then
          rm -f "$enc_hdrfile" "$enc_bodyfile"
          code_not_found "$ACTUAL_CANDIDATE" "$DECODED_BACKEND" ""
          exit 1
        fi
        rm -f "$enc_hdrfile"

        if ! decrypt_and_emit "$ENC_KEY" "$enc_bodyfile"; then
          rm -f "$enc_bodyfile"
          exit 1
        fi
        rm -f "$enc_bodyfile"
        exit 0
      else
        if retrieve_url "${FETCH_HOST%/}/${DECODED_ID}"; then
          exit 0
        fi
      fi
      # else: fall through to upload (only for non-encrypted)
    elif [[ "$ACTUAL_CANDIDATE" == *.* ]]; then
      # Escape-path code: the literal .ext follows the id.
      if [[ -n "$HOST" ]]; then
        FETCH_HOST="$HOST"
      elif [[ "$DECODED_BACKEND" == "catbox" ]]; then
        FETCH_HOST="$DEFAULT_FETCH_HOST_CATBOX"
      else
        FETCH_HOST="$DEFAULT_FETCH_HOST_LITTERBOX"
      fi
      if [[ -n "$ENC_KEY" ]]; then
        # Encrypted retrieval — do NOT fall back to upload on 404
        check_openssl
        enc_hdrfile="$(mktemp)"
        enc_bodyfile="$(mktemp)"
        enc_http_code="$(curl -sSL -D "$enc_hdrfile" -o "$enc_bodyfile" \
          -w '%{http_code}' "${FETCH_HOST%/}/${DECODED_ID}")"
        if [[ "$enc_http_code" -ge 400 ]]; then
          rm -f "$enc_hdrfile" "$enc_bodyfile"
          code_not_found "$ACTUAL_CANDIDATE" "$DECODED_BACKEND" ""
          exit 1
        fi
        rm -f "$enc_hdrfile"

        if ! decrypt_and_emit "$ENC_KEY" "$enc_bodyfile"; then
          rm -f "$enc_bodyfile"
          exit 1
        fi
        rm -f "$enc_bodyfile"
        exit 0
      else
        if retrieve_url "${FETCH_HOST%/}/${DECODED_ID}"; then
          exit 0
        fi
      fi
    fi
  fi
fi

case "$BACKEND" in
  catbox)      DEFAULT_HOST="$DEFAULT_UPLOAD_HOST_CATBOX" ;;
  litterbox)   DEFAULT_HOST="$DEFAULT_UPLOAD_HOST_LITTERBOX" ;;
  *)
    echo "wcp: unknown backend: $BACKEND (expected: catbox, litterbox)" >&2
    exit 1
    ;;
esac
[[ -z "$HOST" ]] && HOST="$DEFAULT_HOST"
HOST="${HOST%/}"

# Match the tool to the session: a tool present for the wrong display server
# cannot connect. Redirect stdio too, or the forked daemon holds our stdout.
do_copy() {
  local text="$1" rc=0
  if command -v pbcopy &>/dev/null; then
    printf '%s' "$text" | pbcopy >/dev/null 2>&1 || rc=$?
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &>/dev/null; then
    printf '%s' "$text" | wl-copy >/dev/null 2>&1 || rc=$?
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip &>/dev/null; then
    printf '%s' "$text" | xclip -selection clipboard >/dev/null 2>&1 || rc=$?
  elif [[ -n "${DISPLAY:-}" ]] && command -v xsel &>/dev/null; then
    printf '%s' "$text" | xsel --clipboard --input >/dev/null 2>&1 || rc=$?
  else
    echo "wcp: -c found no usable clipboard tool; install $(clip_hint)" >&2
    return 0
  fi
  if [[ $rc -ne 0 ]]; then
    echo "wcp: -c could not reach the clipboard (tool exited $rc)" >&2
  fi
}


# Backends

up_catbox_file()  { curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${1}" "$HOST"; }
up_catbox_text() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  printf '%s' "$1" > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}
up_catbox_stdin() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  cat > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}

# backend: litterbox (POST, multipart reqtype=fileupload + time)
up_litterbox_file() {
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" \
    -F "fileToUpload=@${1}" "$HOST"
}
up_litterbox_text() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  printf '%s' "$1" > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}
up_litterbox_stdin() {
  local tmp
  tmp="$(mktemp /tmp/wcp-paste.XXXXXX.txt)"
  cat > "$tmp"
  curl -sS -F "reqtype=fileupload" -F "time=${LBTIME}" -F "fileToUpload=@${tmp}" "$HOST"
  rm -f "$tmp"
}

dispatch() {
  local kind="$1" # file | text | stdin
  local arg="${2:-}"
  case "$BACKEND" in
    catbox)
      case "$kind" in
        file)  up_catbox_file "$arg" ;;
        text)  up_catbox_text "$arg" ;;
        stdin) up_catbox_stdin ;;
      esac
      ;;
    litterbox)
      case "$kind" in
        file)  up_litterbox_file "$arg" ;;
        text)  up_litterbox_text "$arg" ;;
        stdin) up_litterbox_stdin ;;
      esac
      ;;
  esac
}

# Warn here rather than at parse time, so retrievals stay quiet.
if [[ $WARN_NO_OPENSSL -eq 1 ]]; then
  perm=""
  [[ "$BACKEND" == "catbox" ]] && perm=" and permanently"
  echo "wcp: openssl not found — uploading to $BACKEND UNENCRYPTED${perm}" >&2
  echo "wcp: install openssl, or pass --plain to silence this" >&2
fi

if [[ ${#ARGS[@]} -eq 0 || ( ${#ARGS[@]} -eq 1 && "${ARGS[0]}" == "-" ) ]]; then
  # Announce that we are waiting on stdin.
  if [[ -t 0 ]]; then
    echo "wcp: reading stdin — paste or type, then Ctrl-D to send (Ctrl-C cancels)" >&2
  fi
  # Buffer stdin so empty input is rejected before uploading.
  STDIN_TMP="$(mktemp /tmp/wcp-stdin.XXXXXX)"
  cat > "$STDIN_TMP"
  if [[ ! -s "$STDIN_TMP" ]]; then
    rm -f "$STDIN_TMP"
    echo "wcp: nothing on stdin — nothing to upload" >&2
    exit 1
  fi
  exec < "$STDIN_TMP"
  rm -f "$STDIN_TMP"
  if [[ $ENCRYPT -eq 1 ]]; then
    check_openssl
    KEY="$(gen_key)"
    TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
    cat | encrypt_content "$KEY" > "$TMPF"
    ENC_CONTENT="$(cat "$TMPF")"
    rm -f "$TMPF"
    RESULT="$(dispatch text "$ENC_CONTENT")"
    if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
      echo "wcp: upload failed on backend '$BACKEND' ($HOST)" >&2
      echo "wcp: backend reply: ${RESULT:-<empty response>}" >&2
      exit 1
    fi
    ID_FULL="$(strip_host "$RESULT")"
    CODE="$(encode_id "$ID_FULL" "$BACKEND")"
    echo "${CODE}-${KEY}"
    if [[ $COPY -eq 1 ]]; then do_copy "${CODE}-${KEY}"; fi
    exit 0
  else
    RESULT="$(dispatch stdin)"
  fi
elif [[ ${#ARGS[@]} -eq 1 && -f "${ARGS[0]}" ]]; then
  if [[ $ENCRYPT -eq 1 ]]; then
    check_openssl
    FPATH="${ARGS[0]}"
    FSIZE="$(stat -c%s "$FPATH" 2>/dev/null || stat -f%z "$FPATH" 2>/dev/null)"
    if [[ "$FSIZE" -le $MAX_ENC_SIZE ]]; then
      KEY="$(gen_key)"
      FNAME="$(basename "$FPATH")"
      TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
      { printf 'wcp-name:%s\n' "$FNAME"; cat "$FPATH"; } \
        | encrypt_content "$KEY" > "$TMPF"
      ENC_CONTENT="$(cat "$TMPF")"
      rm -f "$TMPF"
      RESULT="$(dispatch text "$ENC_CONTENT")"
      if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
        echo "wcp: upload failed on backend '$BACKEND' ($HOST)" >&2
        echo "wcp: backend reply: ${RESULT:-<empty response>}" >&2
        exit 1
      fi
      ID_FULL="$(strip_host "$RESULT")"
      CODE="$(encode_id "$ID_FULL" "$BACKEND")"
      echo "${CODE}-${KEY}"
      if [[ $COPY -eq 1 ]]; then do_copy "${CODE}-${KEY}"; fi
      exit 0
    else
      HSIZE="$(human_size "$FSIZE")"
      LIMIT="$(human_size $MAX_ENC_SIZE)"
      BN="$(basename "$FPATH")"
      echo "wcp: not encrypting $BN - $HSIZE over the $LIMIT limit, uploading as-is" >&2
      RESULT="$(dispatch file "$FPATH")"
    fi
  else
    RESULT="$(dispatch file "${ARGS[0]}")"
  fi
else
  if [[ $ENCRYPT -eq 1 ]]; then
    check_openssl
    KEY="$(gen_key)"
    TEXT="${ARGS[*]}"
    TMPF="$(mktemp /tmp/wcp-enc.XXXXXX)"
    printf '%s' "$TEXT" | encrypt_content "$KEY" > "$TMPF"
    ENC_CONTENT="$(cat "$TMPF")"
    rm -f "$TMPF"
    RESULT="$(dispatch text "$ENC_CONTENT")"
    if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
      echo "wcp: upload failed on backend '$BACKEND' ($HOST)" >&2
      echo "wcp: backend reply: ${RESULT:-<empty response>}" >&2
      exit 1
    fi
    ID_FULL="$(strip_host "$RESULT")"
    CODE="$(encode_id "$ID_FULL" "$BACKEND")"
    echo "${CODE}-${KEY}"
    if [[ $COPY -eq 1 ]]; then do_copy "${CODE}-${KEY}"; fi
    exit 0
  else
    TEXT="${ARGS[*]}"
    RESULT="$(dispatch text "$TEXT")"
  fi
fi

if [[ ! "$RESULT" =~ ^https?://[^[:space:]]+$ ]]; then
  echo "wcp: upload failed on backend '$BACKEND' ($HOST)" >&2
  echo "wcp: backend reply: ${RESULT:-<empty response>}" >&2
  exit 1
fi

ID_FULL="$(strip_host "$RESULT")"
CODE="$(encode_id "$ID_FULL" "$BACKEND")"

echo "$CODE"
if [[ $COPY -eq 1 ]]; then do_copy "$CODE"; fi
