#!/bin/bash
# wcp — minimal upload wrapper with a compact roundtrip code.
#
# USAGE:
#   wcp path/to/file.txt        # upload -> prints a short code, e.g. "brbkswy"
#   wcp some words here         # not a file -> uploaded as text, prints a code
#   echo "text" | wcp           # no args -> reads stdin, prints a code
#   wcp brbkswy                 # retrieve (implicit): may fall back to uploading
#   wcp . brbkswy               # retrieve (explicit): errors instead of falling back
#   wcp . <full-url>            # retrieve by URL instead of a code
#   wcp . brbkswy -o out.txt    # ...saved under a name you choose
#
# Retrieved text prints to stdout; retrieved files are saved into the current
# folder. Existing files are never overwritten — _1, _2 are appended and the
# name actually used is printed. Encrypted files restore their original name.
#
# The first character of the printed code encodes BOTH the backend and the
# file extension. Lowercase a-o = litterbox, uppercase A-O = catbox.
# Digits 0/1 mean the extension is not in the built-in table (the literal
# .ext follows the prefix). A typical code is 7 characters long.
# Letters p-z, P-Z and digits 2-9 are reserved for a future third backend.
#
# -b / --backend and --host work for both directions: on upload they choose
# which service and endpoint is used; on retrieval, --host overrides the
# default fetch host for the decoded backend.
#
# -t [hours] takes a whole number of hours and rounds UP to the nearest of
# 1h, 12h, 24h, 72h (litterbox only; catbox never expires). Max 72h.
#
# Env vars: WCP_BACKEND (default: catbox), WCP_TIME (whole hours, default 1)
#
# Collision handling: a candidate of 7 chars or fewer that looks like a code is
# tried as a retrieval first; if that 404s it falls back to uploading it as
# text. Longer candidates are only tried if they contain a . or a - (escape and
# escape-path codes carry a dot, encrypted codes a dash), so an ordinary long
# word is uploaded straight away with no wasted request.
#
# With a key stored (--set-key), every upload is encrypted with it and the
# code stays 7 characters, because the key never travels; -z opts out.
# With no stored key: catbox is encrypted with a random per-upload key that
# rides in the code, litterbox is plain because it expires within hours.
# -e / --encrypt forces it on; --plain / -p and WCP_PLAIN=1 force it off.
# Encrypted codes use a 12-char alphanumeric key: CODE-KEY (~20 chars total).
# The KEY is NEVER uploaded — only the ciphertext goes to the server.
# Losing the KEY loses the data permanently.
#   wcp -b c hello world -> B0ojyr4-AbCdEfGhIjKl
# curl and openssl are both required.
# Files up to 1 MB are encrypted, any type; -f raises that to 100 MB.
#
# -l prints the full URL instead of the code; with -e the key follows on a
# second line and only the URL is copied. Retrieve with: wcp . <url> <key>
#
# -a appends stdin, argument text or the clipboard to a local buffer, -s
# uploads it, --clear empties it. Entries are separated by two blank lines,
# and a piped entry is labelled with the command that produced it.
#
# Short aliases: -b backend, -c copy, -e encrypt, -f force, -l link,
# -p plain, -t time.
set -euo pipefail

# Logging

print_info() {
  printf 'wcp: %s\n' "$*" >&2
}

print_warn() {
  printf 'wcp: %s\n' "$*" >&2
}

print_error() {
  printf 'wcp: %s\n' "$*" >&2
}


readonly DEFAULT_UPLOAD_HOST_CATBOX="https://catbox.moe/user/api.php"
readonly DEFAULT_FETCH_HOST_CATBOX="https://files.catbox.moe"
readonly LB_API="/resources/internals/api.php"
readonly DEFAULT_UPLOAD_HOST_LITTERBOX="https://litterbox.catbox.moe${LB_API}"
readonly DEFAULT_FETCH_HOST_LITTERBOX="https://litter.catbox.moe"
readonly DEFAULT_LITTERBOX_TIME="1h"

# Extension table: index 0 = no extension, 1..14 = common extensions.
readonly -a EXT_TABLE=( "" txt md log json yaml csv conf sh py png jpg pdf zip gz )

encode_id() {
  local id_full="$1" backend="$2"
  local id_base ext prefix

  # Split on the LAST dot
  if [[ "$id_full" == *.* ]]; then
    ext="${id_full##*.}"
    id_base="${id_full%.*}"
  else
    id_base="$id_full"
    ext=""
  fi

  # Look up ext in EXT_TABLE
  local found=0 i
  for i in "${!EXT_TABLE[@]}"; do
    if [[ "${EXT_TABLE[$i]}" == "$ext" ]]; then
      found=1
      if [[ "$backend" == "catbox" ]]; then
        # uppercase: A=0, B=1, ...
        printf -v prefix '%b' "\\$(printf '%03o' $((65 + i)))"
      else
        # lowercase: a=0, b=1, ...
        printf -v prefix '%b' "\\$(printf '%03o' $((97 + i)))"
      fi
      echo "${prefix}${id_base}"
      return
    fi
  done

  # Not found: use 0 for litterbox, 1 for catbox, keep literal .ext
  if [[ "$backend" == "catbox" ]]; then
    echo "1${id_base}.${ext}"
  else
    echo "0${id_base}.${ext}"
  fi
}

decode_code() {
  local candidate="$1"
  local letter="${candidate:0:1}"
  local rest="${candidate:1}"

  # Digit prefix: extension is not in the table, REST holds the literal .ext.
  if [[ "$letter" == "0" || "$letter" == "1" ]]; then
    if [[ "$letter" == "0" ]]; then
      DECODED_BACKEND="litterbox"
    else
      DECODED_BACKEND="catbox"
    fi
    DECODED_ID="$rest"
    return 0
  fi

  # Alphabetic prefix: look the extension up in the table.
  local i
  if [[ "$letter" =~ [a-z] ]]; then
    DECODED_BACKEND="litterbox"
    i=$(( $(printf '%d' "'$letter") - 97 ))
  elif [[ "$letter" =~ [A-Z] ]]; then
    DECODED_BACKEND="catbox"
    i=$(( $(printf '%d' "'$letter") - 65 ))
  else
    return 1
  fi

  if [[ $i -lt 0 || $i -ge ${#EXT_TABLE[@]} ]]; then
    return 1
  fi

  local ext="${EXT_TABLE[$i]}"
  if [[ -z "$ext" ]]; then
    DECODED_ID="$rest"
  else
    DECODED_ID="${rest}.${ext}"
  fi
  return 0
}

litterbox_time_bucket() {
  local h="${1%h}"
  if [[ ! "$h" =~ ^[0-9]+$ ]] || [[ "$h" -lt 1 ]]; then
    print_error "-t takes a whole number of hours, 1 to 72"
    return 1
  fi
  if   [[ "$h" -le 1  ]]; then echo "1h"
  elif [[ "$h" -le 12 ]]; then echo "12h"
  elif [[ "$h" -le 24 ]]; then echo "24h"
  elif [[ "$h" -le 72 ]]; then echo "72h"
  else
    print_error "-t max is 72 hours (litterbox allows 1, 12, 24, 72)"
    return 1
  fi
}

# Strip scheme://host from a URL, leaving the path as the id.
strip_host() {
  local url="$1"
  url="${url#https://}"
  url="${url#http://}"
  url="${url#*/}"
  echo "$url"
}


# Retrieval

# True when a body is base64 ciphertext we produced.
check_encrypted() {
  local f="$1"
  [[ "$(head -c 10 "$f" 2>/dev/null)" == "U2FsdGVkX1" ]] || return 1
  LC_ALL=C grep -qv '^[A-Za-z0-9+/=]*$' "$f" && return 1
  return 0
}

retrieve_url() {
  local url="$1"
  local override_out="${2:-}"
  local hdrfile bodyfile ctype http_code
  hdrfile="$(mktemp)"
  bodyfile="$(mktemp)"
  http_code="$(curl -sSL -D "$hdrfile" -o "$bodyfile" -w '%{http_code}' "$url")"

  if [[ "$http_code" -ge 400 ]]; then
    rm -f "$hdrfile" "$bodyfile"
    return 1
  fi

  # A stored-key upload carries no key in its code, so recognise it by shape.
  if check_encrypted "$bodyfile"; then
    rm -f "$hdrfile"
    if [[ -z "${STORED_KEY:-}" ]]; then
      rm -f "$bodyfile"
      print_error "this upload is encrypted, but no key is set on this machine"
      print_error "run --set-key with the key from the machine that sent it"
      return 1
    fi
    if ! decrypt_and_emit "$STORED_KEY" "$bodyfile" "$override_out"; then
      rm -f "$bodyfile"
      print_error "this machine's key does not match the one used to upload it"
      return 1
    fi
    rm -f "$bodyfile"
    return 0
  fi

  ctype="$(grep -i '^content-type:' "$hdrfile" | tail -1 \
    | cut -d: -f2- | tr -d '\r' | xargs || true)"

  if [[ -n "$override_out" ]]; then
    local out_name
    out_name="$(unique_save_name "$override_out")"
    mv "$bodyfile" "$out_name"
    echo "Saved to $out_name"
  elif [[ "$ctype" == text/* ]]; then
    emit_text "$bodyfile"
    rm -f "$bodyfile"
  else
    local fname
    fname="$(basename "$url")"
    [[ -z "$fname" || "$fname" == "/" ]] && fname="downloaded_file"
    local save_name
    save_name="$(unique_save_name "./$fname")"
    mv "$bodyfile" "$save_name"
    echo "Saved as $(basename "$save_name")"
  fi
  rm -f "$hdrfile"
  return 0
}


# Helpers

# Read the stored key, or nothing when none is set.
read_stored_key() {
  [[ -r "$KEY_PATH" ]] || return 0
  local k
  IFS= read -r k < "$KEY_PATH" || true
  printf '%s' "$k"
}

# Write the key 0600, so it is no more exposed than an ssh private key.
write_stored_key() {
  local k="$1"
  if [[ ${#k} -lt $MIN_STORED_KEY ]]; then
    print_error "a stored key needs at least $MIN_STORED_KEY characters"
    print_error "run --set-key with no value to generate one"
    return 1
  fi
  if [[ ! "$k" =~ ^[A-Za-z0-9]+$ ]]; then
    print_error "a stored key may only contain letters and digits"
    return 1
  fi
  mkdir -p "$(dirname "$KEY_PATH")"
  ( umask 077; printf '%s\n' "$k" > "$KEY_PATH" )
  chmod 600 "$KEY_PATH"
}

# Name the clipboard package that fits the running display server.
clip_hint() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "wl-clipboard"
  elif [[ -n "${DISPLAY:-}" ]]; then
    echo "xclip"
  else
    echo "a clipboard tool, but this session has no display"
  fi
}

# Read the clipboard. Returns 2 when no clipboard tool exists.
do_paste() {
  if command -v pbpaste &>/dev/null; then
    pbpaste
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-paste &>/dev/null; then
    wl-paste --no-newline 2>/dev/null
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip &>/dev/null; then
    xclip -selection clipboard -o 2>/dev/null
  elif [[ -n "${DISPLAY:-}" ]] && command -v xsel &>/dev/null; then
    xsel --clipboard --output 2>/dev/null
  else
    return 2
  fi
}

# Print retrieved text, adding a trailing newline only on a terminal.
emit_text() {
  local f="$1"
  cat "$f"
  if [[ -t 1 && -s "$f" && $(tail -c1 "$f" | wc -l) -eq 0 ]]; then
    echo
  fi
}

code_not_found() {
  local code="$1" backend="$2" ext="$3"
  print_warn "no such code '${code}' (${backend}, ${ext:-no extension})"
  if [[ "$backend" == "litterbox" ]]; then
    print_warn "litterbox codes expire — the default window is 1h"
  fi
}

# Fail early when curl or openssl is missing.
require_tools() {
  local missing=()
  command -v curl &>/dev/null || missing+=("curl")
  command -v openssl &>/dev/null || missing+=("openssl")
  [[ ${#missing[@]} -eq 0 ]] && return 0
  print_warn "missing required tool(s): ${missing[*]}"
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    print_warn "install with: brew install ${missing[*]}"
  elif command -v apt &>/dev/null; then
    print_warn "install with: sudo apt install ${missing[*]}"
  elif command -v dnf &>/dev/null; then
    print_warn "install with: sudo dnf install ${missing[*]}"
  elif command -v pacman &>/dev/null; then
    print_error "install with: sudo pacman -S ${missing[*]}"
  else
    print_error "install them with your package manager"
  fi
  exit 1
}

check_openssl() {
  require_tools
}

encrypt_content() {
  local key="$1"
  openssl enc -aes-256-cbc -pbkdf2 -iter 10000 -salt -pass "pass:$key" | base64 -w0
}

decrypt_content() {
  local key="$1"
  base64 -d | openssl enc -d -aes-256-cbc -pbkdf2 -iter 10000 -pass "pass:$key"
}

human_size() {
  local bytes="$1"
  if [[ $bytes -ge 1048576 ]]; then
    echo "$(( bytes / 1048576 )) MB"
  elif [[ $bytes -ge 1024 ]]; then
    echo "$(( (bytes + 512) / 1024 )) KB"
  else
    echo "${bytes} B"
  fi
}

# Run the executable blocks in tests.md, in a sandbox of their own.
run_tests() {
  local sheet="${1:-}"
  if [[ -z "$sheet" ]]; then
    local beside="$(dirname "$(readlink -f "$0")")/tests.md"
    if [[ -r "$beside" ]]; then
      sheet="$beside"
    elif [[ -r "./tests.md" ]]; then
      sheet="./tests.md"
    else
      print_error "no tests.md beside wcp or in this directory"
      print_error "pass one explicitly: wcp --run-tests <file.md>"
      return 1
    fi
  fi
  if [[ ! -r "$sheet" ]]; then
    print_error "cannot read $sheet"
    return 1
  fi

  local sandbox work script
  sandbox="$(mktemp -d /tmp/wcp-tests.XXXXXX)"
  work="$sandbox/work"
  script="$sandbox/run.sh"
  mkdir -p "$work" "$sandbox/config" "$sandbox/cache"

  # Turn the sheet into one shell script so variables persist between blocks.
  local in_fence=0 line cmd expect_kind expect
  {
    printf '%s\n' 'WCP_PASS=0; WCP_FAIL=0; WCP_OUT=""'
    printf '%s\n' 'wcp() { command "$WCP_BIN" "$@"; }'
    printf '%s\n' 'wcp_run() { { eval "$1"; } >"$WCP_TMP" 2>&1 </dev/null; WCP_OUT="$(cat "$WCP_TMP")"; }'
    printf '%s\n' 'wcp_expect() {'
    printf '%s\n' '  if [[ "$1" == re ]]; then'
    printf '%s\n' '    if [[ "$WCP_OUT" =~ $2 ]]; then WCP_PASS=$((WCP_PASS+1));'
    printf '%s\n' '    else WCP_FAIL=$((WCP_FAIL+1)); printf "  FAIL %s\\n       got: %s\\n" "$2" "${WCP_OUT:0:70}"; fi'
    printf '%s\n' '  else'
    printf '%s\n' '    if [[ "$WCP_OUT" == *"$2"* ]]; then WCP_PASS=$((WCP_PASS+1));'
    printf '%s\n' '    else WCP_FAIL=$((WCP_FAIL+1)); printf "  FAIL %s\\n       got: %s\\n" "$2" "${WCP_OUT:0:70}"; fi'
    printf '%s\n' '  fi'
    printf '%s\n' '}'
    while IFS= read -r line; do
      if [[ "$line" =~ ^\`\`\`bash[[:space:]]*$ ]]; then in_fence=1; continue; fi
      if [[ "$line" =~ ^\`\`\` ]]; then in_fence=0; continue; fi
      [[ $in_fence -eq 1 ]] || continue
      [[ -z "${line// }" ]] && continue
      if [[ "$line" =~ ^#[[:space:]]*-\>[[:space:]]?(.*)$ ]]; then
        printf 'wcp_expect sub %q\n' "${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^#[[:space:]]*~\>[[:space:]]?(.*)$ ]]; then
        printf 'wcp_expect re %q\n' "${BASH_REMATCH[1]}"
      elif [[ "$line" =~ ^# ]]; then
        continue
      else
        printf 'wcp_run %q\n' "$line"
      fi
    done < "$sheet"
    printf '%s\n' 'printf "\\n%s passed, %s failed\\n" "$WCP_PASS" "$WCP_FAIL"'
    printf '%s\n' '[[ $WCP_FAIL -eq 0 ]]'
  } > "$script"

  print_info "running $sheet"
  local rc=0
  (
    cd "$work" || exit 1
    export XDG_CONFIG_HOME="$sandbox/config"
    export XDG_CACHE_HOME="$sandbox/cache"
    export WCP_BIN WCP_TMP="$sandbox/out"
    export WCP_NO_COPY=1
    bash "$script"
  ) || rc=$?
  rm -rf "$sandbox"
  return $rc
}

# Show the buffer: head and tail only on a terminal, unless --full.
show_buffer() {
  if [[ ! -f "$BUFFER_PATH" || ! -s "$BUFFER_PATH" ]]; then
    print_warn "buffer is empty - nothing to show"
    return 0
  fi
  local total entries sz
  total=$(wc -l < "$BUFFER_PATH")
  if [[ $FULL -eq 1 || ! -t 1 || "$total" -le 10 ]]; then
    cat "$BUFFER_PATH"
  else
    head -5 "$BUFFER_PATH"
    printf '... %s lines hidden, --full shows everything ...\n' "$((total - 10))"
    tail -5 "$BUFFER_PATH"
  fi
  entries=$(count_entries "$BUFFER_PATH")
  sz="$(human_size "$(wc -c < "$BUFFER_PATH")")"
  print_info "$(plural_entries "$entries"), $sz"
}

# Say "1 entry" rather than "1 entries".
plural_entries() {
  if [[ "$1" -eq 1 ]]; then
    printf '1 entry'
  else
    printf '%s entries' "$1"
  fi
}

# Count buffer entries separated by two blank lines.
count_entries() {
  awk 'BEGIN{n=1}
    /^$/{b++; next}
    b>=2{n++; b=0}
    /^$/{b=0}
    END{if(b>=2)n++; print n}' "$1"
}

# Append _1, _2 before the extension until the name is free.
unique_save_name() {
  local base="$1"
  if [[ ! -e "$base" ]]; then
    echo "$base"
    return
  fi
  local name ext
  if [[ "$base" == *.* ]]; then
    ext="${base##*.}"
    name="${base%.*}"
  else
    ext=""
    name="$base"
  fi
  local i=1
  while true; do
    local candidate
    if [[ -n "$ext" ]]; then
      candidate="${name}_${i}.${ext}"
    else
      candidate="${name}_${i}"
    fi
    if [[ ! -e "$candidate" ]]; then
      echo "$candidate"
      return
    fi
    i=$((i + 1))
  done
}

# Name the pipeline feeding stdin, from the parent shell's child list.
pipe_writer_cmd() {
  [[ -p /dev/stdin ]] || return 0
  local childfile="/proc/$PPID/task/$PPID/children"
  [[ -r "$childfile" ]] || return 0
  local children
  children="$(cat "$childfile" 2>/dev/null)"
  [[ -n "$children" ]] || return 0
  local out="" pid cmd
  for pid in $children; do
    [[ "$pid" -eq $$ ]] && break
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    cmd="${cmd%"${cmd##*[![:space:]]}"}"
    [[ -n "$cmd" ]] || continue
    # A shell wrapping an alias or function is harness noise, not the command.
    [[ "$cmd" =~ ^(/[^[:space:]]*/)?(ba|z|da)?sh[[:space:]]+-c[[:space:]] ]] && continue
    [[ ${#cmd} -gt 200 ]] && continue
    [[ -n "$out" ]] && out+=" | "
    out+="$cmd"
  done
  PIPE_CMD="$out"
}

KEY_LEN="${WCP_KEY_LEN:-12}"
readonly MAX_ENC_SIZE=1048576
readonly MAX_FORCE_SIZE=104857600    # 100 MB, -f ceiling on catbox and litterbox
readonly BUFFER_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/wcp/buffer"
readonly KEY_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/wcp/key"
readonly MIN_STORED_KEY=20

# Set KEY to encrypt with, and EMIT_KEY to the key the code should carry.
select_key() {
  if [[ -n "$STORED_KEY" ]]; then
    KEY="$STORED_KEY"
    EMIT_KEY=""
  else
    KEY="$(gen_key)"
    EMIT_KEY="$KEY"
  fi
}

# Build a KEY_LEN key from [A-Za-z0-9], failing if it is malformed.
gen_key() {
  local want="${1:-$KEY_LEN}"
  local k=""
  while [[ ${#k} -lt $want ]]; do
    k="${k}$(openssl rand -base64 48 | LC_ALL=C tr -dc 'A-Za-z0-9')"
  done
  k="${k:0:$want}"
  if [[ ${#k} -ne $want ]] || [[ "$k" =~ [^A-Za-z0-9] ]]; then
    print_error "internal error — generated key failed its format check"
    return 1
  fi
  printf '%s' "$k"
}

# Decrypt a body, saving under its wcp-name header or printing it.
decrypt_and_emit() {
  local key="$1" bodyfile="$2" override_out="${3:-}"
  local plainfile first_line fname save_name
  plainfile="$(mktemp /tmp/wcp-dec.XXXXXX)"
  if ! decrypt_content "$key" < "$bodyfile" > "$plainfile" 2>/dev/null; then
    rm -f "$plainfile"
    print_error "could not decrypt — the key may be wrong or the upload corrupted"
    return 1
  fi
  IFS= read -r first_line < "$plainfile" || first_line=""
  if [[ -n "$override_out" ]]; then
    local out_name
    out_name="$(unique_save_name "$override_out")"
    if [[ "$first_line" == wcp-name:* ]]; then
      tail -n +2 "$plainfile" > "$out_name"
    else
      cp "$plainfile" "$out_name"
    fi
    echo "Saved to $out_name"
  elif [[ "$first_line" == wcp-name:* ]]; then
    fname="${first_line#wcp-name:}"
    save_name="$(unique_save_name "./$fname")"
    tail -n +2 "$plainfile" > "$save_name"
    echo "Saved as $(basename "$save_name")"
  else
    emit_text "$plainfile"
  fi
  rm -f "$plainfile"
  return 0
}

usage() {
    cat << 'USAGE'
wcp — upload a file, some text, or stdin; get back a short code.

Usage:
  wcp <file>                     upload a file
  wcp some words here            upload text
  echo text | wcp                upload stdin
  wcp                            read stdin; use this for MULTI-LINE text
  wcp <code>                     retrieve; falls back to uploading on a miss
  wcp . <code|url>               retrieve; errors on a miss
  wcp <code|url> -o <file>       retrieve and save under a chosen name

Options:
  -b, --backend <name>   catbox (default) or litterbox; -b c / -b l also work
      --host <url>       override the backend endpoint, or the fetch host
  -t, --time <hours>     litterbox expiry, rounds up to 1/12/24/72 (default 1)
  -e, --encrypt          force client-side encryption
  -p, --plain            force no encryption
  -c, --copy             copy the code even when output is redirected
  -n, --no-copy          do not copy the code to the clipboard
  -k, --key-len <n>      encryption key length, 12 to 64 (default 12)
  -l, --link             print the full URL instead of the short code
  -f, --force            encrypt a file of any type, up to 100 MB
  -a, --accumulate       append stdin, text or the clipboard to the buffer
                         with nothing to append, shows the buffer instead
  -s, --send             upload the accumulated buffer and clear it
      --clear            empty the buffer without uploading
      --full             with -a, show the whole buffer, not head and tail
      --run-tests [file] run the blocks in tests.md and report pass/fail
  -v, --paste            upload the clipboard contents (takes no arguments)
  -z, --no-stored-key    ignore the stored key for this run
  -h, --help             show this help

Key store:
      --set-key [key]    store a key (20+ chars); with no value, generate one
      --get-key          print the stored key
      --clear-key        forget the stored key

With a key stored, every upload is encrypted with it and the code stays 7
characters, because the key never travels. Both machines need the same key.

Encryption: litterbox is plain because it expires; every other backend is
encrypted. The key travels inside the code and never reaches the server, so
losing the code loses the data. openssl is required only when encrypting.

Multi-line text cannot be passed as arguments: the shell splits a pasted
block on its newlines before wcp runs, so only the first line arrives. Run
bare 'wcp', paste, then press Ctrl-D.

Env: WCP_BACKEND, WCP_TIME (whole hours), WCP_PLAIN=1, WCP_KEY_LEN, WCP_NO_COPY=1
USAGE
}


